#!/bin/bash
# ==============================================================================
# sd - System Shutdown for Pop!_OS COSMIC / systemd
# ==============================================================================

DRY_RUN=0
FORCE=0
for arg in "$@"; do
    case "$arg" in
        -f|--force|-i|--ignore-inhibitors)
            FORCE=1
            ;;
        -n|--dry-run)
            DRY_RUN=1
            ;;
    esac
done

if [ "$DRY_RUN" -eq 1 ]; then
    echo "[dry-run] Testing shutdown capability (no actual shutdown)..."
    if [ "$FORCE" -eq 1 ]; then
        systemctl --dry-run poweroff -i && echo "[dry-run] Authorization confirmed for unprivileged poweroff (ignoring inhibitors)." && exit 0
    else
        systemctl --dry-run poweroff && echo "[dry-run] Authorization confirmed for unprivileged poweroff." && exit 0
    fi
    echo "[dry-run] Direct poweroff not authorized; would require sudo."
    exit 0
fi

# Notify desktop session if running under graphical environment
if command -v notify-send &>/dev/null && [ -n "$DISPLAY$WAYLAND_DISPLAY" ]; then
    notify-send -u critical -i system-shutdown "Pop!_OS COSMIC" "Shutting down system..." 2>/dev/null || true
fi

echo "Initiating system shutdown..."

# 1. Preferred modern method: unprivileged systemctl poweroff via systemd-logind
# In a Pop!_OS COSMIC desktop session, local seat users are authorized by polkit
# to cleanly power off without requiring root or sudo.
if [ "$FORCE" -eq 1 ]; then
    systemctl poweroff -i 2>/dev/null && exit 0
else
    systemctl poweroff 2>/dev/null && exit 0
fi

# 2. Fallback to sudo if unprivileged shutdown was rejected (e.g. SSH / non-seat session)
echo "[*] Direct shutdown not permitted; authenticating with sudo..."
if [ -n "$USERPASS" ]; then
    if [ "$FORCE" -eq 1 ]; then
        printf '%s\n' "$USERPASS" | sudo -S systemctl poweroff -i 2>/dev/null || printf '%s\n' "$USERPASS" | sudo -S poweroff -f
    else
        printf '%s\n' "$USERPASS" | sudo -S systemctl poweroff 2>/dev/null || printf '%s\n' "$USERPASS" | sudo -S poweroff
    fi
else
    if [ "$FORCE" -eq 1 ]; then
        sudo systemctl poweroff -i 2>/dev/null || sudo poweroff -f
    else
        sudo systemctl poweroff 2>/dev/null || sudo poweroff
    fi
fi
