#!/usr/bin/env python3
"""
sync-bookmarks
Synchronizes bookmarks across Brave (primary), Chrome (tertiary), and Firefox (secondary).
- Backs up existing bookmark stores prior to making any modifications.
- Merges bookmarks across all three browsers with Brave as the authoritative layout reference.
- Normalizes Firefox bookmarks (prunes old duplicate import trees in Menu while preserving standard folders).
- Generates an updated standard Netscape HTML bookmarks file in ~/bin/bookmarks/.
"""

import os
import sys
import json
import sqlite3
import shutil
import time
import uuid
import html
from datetime import datetime

# Paths
BRAVE_PATH = os.path.expanduser("~/.config/BraveSoftware/Brave-Browser/Default/Bookmarks")
CHROME_PATH = os.path.expanduser("~/.config/google-chrome/Default/Bookmarks")
FIREFOX_PROFILE_DIR = os.path.expanduser("~/.mozilla/firefox/4xgwnmpi.default-release-1")
FIREFOX_DB_PATH = os.path.join(FIREFOX_PROFILE_DIR, "places.sqlite")
BACKUP_DIR = os.path.expanduser("~/bin/bookmarks")

TIMESTAMP = datetime.now().strftime("%Y_%m_%d_%H%M%S")

def make_backup(file_path, label):
    if not os.path.exists(file_path):
        return None
    os.makedirs(BACKUP_DIR, exist_ok=True)
    base = os.path.basename(file_path)
    backup_file = os.path.join(BACKUP_DIR, f"{base}.backup_{label}_{TIMESTAMP}")
    shutil.copy2(file_path, backup_file)
    print(f"[*] Backed up {label} to {backup_file}")
    return backup_file

def get_chromium_max_id(root_dict):
    max_id = 0
    def walk(node):
        nonlocal max_id
        if "id" in node:
            try:
                max_id = max(max_id, int(node["id"]))
            except (ValueError, TypeError):
                pass
        for c in node.get("children", []):
            walk(c)
    for r in root_dict.values():
        if isinstance(r, dict):
            walk(r)
    return max_id

def extract_chromium_bookmarks(path):
    if not os.path.exists(path):
        return {}
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    items = {}
    def walk(node, path_tuple=()):
        name = node.get("name", "")
        ntype = node.get("type")
        if ntype == "folder":
            cur_path = path_tuple + (name,) if name else path_tuple
            for c in node.get("children", []):
                walk(c, cur_path)
        elif ntype == "url":
            url = node.get("url")
            if url:
                items[url] = {
                    "title": name,
                    "url": url,
                    "path": path_tuple,
                    "date_added": node.get("date_added", str(int(time.time() * 1000000)))
                }
    for rname, rnode in data.get("roots", {}).items():
        if isinstance(rnode, dict):
            walk(rnode, (rname,))
    return items

def extract_firefox_bookmarks(db_path):
    if not os.path.exists(db_path):
        return {}
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    cur = conn.cursor()
    cur.execute("SELECT id, title, parent FROM moz_bookmarks WHERE type = 2")
    folders = {r[0]: (r[1], r[2]) for r in cur.fetchall()}

    def get_f_path(fid):
        p = []
        curr = fid
        while curr in folders:
            name, parent = folders[curr]
            if name:
                p.append(name)
            curr = parent
        return tuple(reversed(p))

    cur.execute("""
        SELECT b.id, b.title, p.url, b.parent, b.dateAdded
        FROM moz_bookmarks b
        JOIN moz_places p ON b.fk = p.id
        WHERE b.type = 1
    """)
    items = {}
    for r in cur.fetchall():
        bid, title, url, parent, date_added = r
        if url and url not in items:
            items[url] = {
                "title": title or "",
                "url": url,
                "path": get_f_path(parent),
                "date_added": date_added
            }
    conn.close()
    return items

def add_url_to_chromium_folder(root_dict, target_folder_names, title, url, next_id_fn):
    # Find folder in roots['bookmark_bar'] or roots['other']
    target = None
    if target_folder_names[0] == "other":
        curr = root_dict.get("other")
        names_to_find = target_folder_names[1:]
    else:
        curr = root_dict.get("bookmark_bar")
        names_to_find = target_folder_names[1:] if target_folder_names[0] == "bookmark_bar" else target_folder_names

    if not names_to_find:
        target = curr
    else:
        for name in names_to_find:
            found = False
            for child in curr.get("children", []):
                if child.get("type") == "folder" and child.get("name") == name:
                    curr = child
                    found = True
                    break
            if not found:
                new_folder = {
                    "children": [],
                    "date_added": str(int(time.time() * 1000000)),
                    "date_last_used": "0",
                    "date_modified": str(int(time.time() * 1000000)),
                    "guid": str(uuid.uuid4()),
                    "id": str(next_id_fn()),
                    "name": name,
                    "type": "folder"
                }
                curr.setdefault("children", []).append(new_folder)
                curr = new_folder
        target = curr

    new_node = {
        "date_added": str(int(time.time() * 1000000)),
        "date_last_used": "0",
        "guid": str(uuid.uuid4()),
        "id": str(next_id_fn()),
        "name": title,
        "type": "url",
        "url": url
    }
    target.setdefault("children", []).append(new_node)
    return True

def sync():
    print(f"=== Starting Bookmark Synchronization [{TIMESTAMP}] ===")

    # 1. Backups
    make_backup(BRAVE_PATH, "brave")
    make_backup(CHROME_PATH, "chrome")
    make_backup(FIREFOX_DB_PATH, "firefox")

    # Read current state
    with open(BRAVE_PATH, "r", encoding="utf-8") as f:
        brave_json = json.load(f)
    with open(CHROME_PATH, "r", encoding="utf-8") as f:
        chrome_json = json.load(f)

    brave_items = extract_chromium_bookmarks(BRAVE_PATH)
    chrome_items = extract_chromium_bookmarks(CHROME_PATH)
    firefox_items = extract_firefox_bookmarks(FIREFOX_DB_PATH)

    all_urls = set(brave_items.keys()) | set(chrome_items.keys()) | set(firefox_items.keys())
    print(f"[*] Found {len(all_urls)} total unique URLs across all browsers.")
    print(f"    - Brave: {len(brave_items)}")
    print(f"    - Chrome: {len(chrome_items)}")
    print(f"    - Firefox: {len(firefox_items)}")

    b_next_id = get_chromium_max_id(brave_json["roots"])
    def get_next_b_id():
        nonlocal b_next_id
        b_next_id += 1
        return b_next_id

    # Add missing URLs to Brave (from Chrome or Firefox)
    added_to_brave = 0
    for u in all_urls:
        if u not in brave_items:
            # Determine best placement
            if u in chrome_items:
                ref = chrome_items[u]
            else:
                ref = firefox_items[u]

            title = ref["title"]
            fpath = list(ref["path"])
            # Normalize path
            if not fpath:
                target_path = ("other",)
            elif fpath[0] in ("bookmark_bar", "toolbar", "Bookmarks bar"):
                target_path = ("bookmark_bar",) + tuple(fpath[1:])
            elif fpath[0] in ("other", "unfiled", "Other bookmarks"):
                target_path = ("other",) + tuple(fpath[1:])
            else:
                target_path = ("other",)

            add_url_to_chromium_folder(brave_json["roots"], target_path, title, u, get_next_b_id)
            added_to_brave += 1

    print(f"[*] Added {added_to_brave} new bookmarks into Brave (authoritative store).")

    # Save updated Brave Bookmarks
    with open(BRAVE_PATH, "w", encoding="utf-8") as f:
        json.dump(brave_json, f, indent=3)

    # 2. Sync to Chrome:
    # Synchronize Chrome so it mirrors Brave's structure and items
    c_next_id = get_chromium_max_id(chrome_json["roots"])
    def get_next_c_id():
        nonlocal c_next_id
        c_next_id += 1
        return c_next_id

    # Mirror Brave's complete roots to Chrome while re-assigning unique IDs
    chrome_json["roots"] = json.loads(json.dumps(brave_json["roots"]))
    def reid_chromium(node):
        node["id"] = str(get_next_c_id())
        for c in node.get("children", []):
            reid_chromium(c)
    for r in chrome_json["roots"].values():
        if isinstance(r, dict):
            for c in r.get("children", []):
                reid_chromium(c)

    with open(CHROME_PATH, "w", encoding="utf-8") as f:
        json.dump(chrome_json, f, indent=3)
    print(f"[*] Synchronized Chrome bookmarks from Brave.")

    # 3. Sync to Firefox:
    # Clear redundant duplicate 'Bookmarks bar' folders in menu, and synchronize toolbar & other
    conn = sqlite3.connect(FIREFOX_DB_PATH)
    cur = conn.cursor()

    # Identify and clean duplicate imported folders in Menu (parent = 2)
    cur.execute("SELECT id, title FROM moz_bookmarks WHERE parent = 2 AND title = 'Bookmarks bar'")
    dupe_bars = cur.fetchall()
    if dupe_bars:
        print(f"[*] Cleaning up {len(dupe_bars)} redundant imported Bookmarks bar folders in Firefox menu...")
        for bar_id, _ in dupe_bars:
            # recursively delete
            def del_folder(fid):
                cur.execute("SELECT id, type FROM moz_bookmarks WHERE parent = ?", (fid,))
                children = cur.fetchall()
                for cid, ctype in children:
                    if ctype == 2:
                        del_folder(cid)
                    else:
                        cur.execute("DELETE FROM moz_bookmarks WHERE id = ?", (cid,))
                cur.execute("DELETE FROM moz_bookmarks WHERE id = ?", (fid,))
            del_folder(bar_id)

    # Clean existing toolbar contents (parent = 3) and unfiled (parent = 5) to cleanly mirror synced state
    cur.execute("SELECT id, type FROM moz_bookmarks WHERE parent = 3")
    for cid, ctype in cur.fetchall():
        def del_rec(fid):
            cur.execute("SELECT id, type FROM moz_bookmarks WHERE parent = ?", (fid,))
            for sub_id, sub_type in cur.fetchall():
                if sub_type == 2:
                    del_rec(sub_id)
                else:
                    cur.execute("DELETE FROM moz_bookmarks WHERE id = ?", (sub_id,))
            cur.execute("DELETE FROM moz_bookmarks WHERE id = ?", (fid,))
        if ctype == 2:
            del_rec(cid)
        else:
            cur.execute("DELETE FROM moz_bookmarks WHERE id = ?", (cid,))

    # Insert items from Brave bookmark_bar into toolbar (parent = 3)
    def insert_node_to_firefox(node, parent_id, pos):
        ntype = node.get("type")
        name = node.get("name", "")
        now_micro = int(time.time() * 1000000)
        bm_guid = str(uuid.uuid4()).replace("-", "")[:12]
        
        if ntype == "folder":
            cur.execute("""
                INSERT INTO moz_bookmarks (type, parent, position, title, dateAdded, lastModified, guid)
                VALUES (2, ?, ?, ?, ?, ?, ?)
            """, (parent_id, pos, name, now_micro, now_micro, bm_guid))
            new_folder_id = cur.lastrowid
            for child_pos, child in enumerate(node.get("children", [])):
                insert_node_to_firefox(child, new_folder_id, child_pos)
        elif ntype == "url":
            url = node.get("url", "")
            # check if url exists in moz_places
            cur.execute("SELECT id FROM moz_places WHERE url = ?", (url,))
            row = cur.fetchone()
            if row:
                place_id = row[0]
                cur.execute("UPDATE moz_places SET foreign_count = foreign_count + 1 WHERE id = ?", (place_id,))
            else:
                place_guid = str(uuid.uuid4()).replace("-", "")[:12]
                rev_host = ".".join(reversed(url.split("/")[2].split("."))) + "." if "://" in url and len(url.split("/")) > 2 else ""
                cur.execute("""
                    INSERT INTO moz_places (url, title, rev_host, visit_count, hidden, typed, frecency, guid, foreign_count)
                    VALUES (?, ?, ?, 0, 0, 0, 140, ?, 1)
                """, (url, name, rev_host, place_guid))
                place_id = cur.lastrowid

            cur.execute("""
                INSERT INTO moz_bookmarks (type, fk, parent, position, title, dateAdded, lastModified, guid)
                VALUES (1, ?, ?, ?, ?, ?, ?, ?)
            """, (place_id, parent_id, pos, name, now_micro, now_micro, bm_guid))

    bb_children = brave_json["roots"]["bookmark_bar"].get("children", [])
    for pos, child in enumerate(bb_children):
        insert_node_to_firefox(child, 3, pos)

    # Insert other bookmarks into unfiled (parent = 5)
    other_children = brave_json["roots"].get("other", {}).get("children", [])
    for pos, child in enumerate(other_children):
        insert_node_to_firefox(child, 5, pos)

    conn.commit()
    conn.close()
    print("[*] Synchronized Firefox bookmarks places database.")

    # 4. Generate Netscape HTML file in ~/bin/bookmarks
    def generate_html(roots):
        out = [
            "<!DOCTYPE NETSCAPE-Bookmark-file-1>",
            "<!-- This is an automatically generated file.",
            "     It will be read and overwritten.",
            "     DO NOT EDIT! -->",
            '<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">',
            "<TITLE>Bookmarks</TITLE>",
            "<H1>Bookmarks</H1>",
            "<DL><p>"
        ]
        def walk_html(node, indent=4):
            sp = " " * indent
            ntype = node.get("type")
            name = html.escape(node.get("name", ""))
            if ntype == "folder":
                extra = ' PERSONAL_TOOLBAR_FOLDER="true"' if node.get("_is_toolbar") else ""
                out.append(f'{sp}<DT><H3 ADD_DATE="{int(time.time())}"{extra}>{name}</H3>')
                out.append(f'{sp}<DL><p>')
                for c in node.get("children", []):
                    walk_html(c, indent + 4)
                out.append(f'{sp}</DL><p>')
            elif ntype == "url":
                u = html.escape(node.get("url", ""))
                out.append(f'{sp}<DT><A HREF="{u}" ADD_DATE="{int(time.time())}">{name}</A>')

        bb = roots.get("bookmark_bar")
        if bb:
            bb_copy = dict(bb)
            bb_copy["_is_toolbar"] = True
            walk_html(bb_copy, 4)
        oth = roots.get("other")
        if oth and oth.get("children"):
            walk_html(oth, 4)
        out.append("</DL><p>")
        return "\n".join(out)

    html_file = os.path.join(BACKUP_DIR, f"bookmarks_{TIMESTAMP}.html")
    latest_html = os.path.join(BACKUP_DIR, "bookmarks.html")
    html_content = generate_html(brave_json["roots"])
    with open(html_file, "w", encoding="utf-8") as f:
        f.write(html_content)
    with open(latest_html, "w", encoding="utf-8") as f:
        f.write(html_content)

    print(f"[*] Exported Netscape HTML to {html_file} and updated {latest_html}")
    print("=== Synchronization Complete ===")

if __name__ == "__main__":
    sync()
