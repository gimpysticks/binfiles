#!/usr/bin/env python3
"""
sync-bookmarks
Synchronizes bookmarks across Brave, Chrome, and Firefox using the system default
browser (or an explicitly provided browser) as the authoritative source of truth.

- Detects the current system default browser via xdg-settings / xdg-mime.
- Performs strict one-way mirroring (no additive union merge) so deletions stay deleted.
- Backs up existing bookmark stores prior to making any modifications.
- Cleans up duplicate/redundant nested folders in secondary browsers.
- Generates an updated standard Netscape HTML bookmarks file in ~/bin/bookmarks/.
"""

import os
import sys
import json
import sqlite3
import shutil
import time
import uuid
import html
import subprocess
import argparse
from datetime import datetime

# Base paths
BRAVE_PATH = os.path.expanduser("~/.config/BraveSoftware/Brave-Browser/Default/Bookmarks")
CHROME_PATH = os.path.expanduser("~/.config/google-chrome/Default/Bookmarks")
BACKUP_DIR = os.path.expanduser("~/bin/bookmarks")

TIMESTAMP = datetime.now().strftime("%Y_%m_%d_%H%M%S")


def get_firefox_profile_dir():
    base = os.path.expanduser("~/.mozilla/firefox")
    ini_path = os.path.join(base, "profiles.ini")
    if os.path.exists(ini_path):
        import configparser
        cp = configparser.ConfigParser()
        cp.read(ini_path)
        for sec in cp.sections():
            if sec.startswith("Install") and cp.has_option(sec, "Default"):
                p = cp.get(sec, "Default")
                full = os.path.join(base, p)
                if os.path.exists(os.path.join(full, "places.sqlite")):
                    return full
        for sec in cp.sections():
            if sec.startswith("Profile") and cp.has_option(sec, "Path"):
                p = cp.get(sec, "Path")
                full = os.path.join(base, p)
                if os.path.exists(os.path.join(full, "places.sqlite")):
                    return full
    fallback = os.path.expanduser("~/.mozilla/firefox/4xgwnmpi.default-release-1")
    if os.path.exists(fallback):
        return fallback
    return None


def detect_system_default():
    candidates = [
        ["xdg-settings", "get", "default-web-browser"],
        ["xdg-mime", "query", "default", "x-scheme-handler/https"],
        ["xdg-mime", "query", "default", "x-scheme-handler/http"],
    ]
    for cmd in candidates:
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, check=False)
            out = res.stdout.strip().lower()
            if "brave" in out:
                return "brave"
            elif "chrome" in out:
                return "chrome"
            elif "firefox" in out:
                return "firefox"
        except Exception:
            pass
    return None


def get_running_browsers():
    running = []
    patterns = {
        "brave": "brave",
        "chrome": "google-chrome|chrome",
        "firefox": "firefox"
    }
    for b_key, pat in patterns.items():
        try:
            res = subprocess.run(["pgrep", "-a", "-f", pat], capture_output=True, text=True, check=False)
            lines = [
                l for l in res.stdout.strip().splitlines()
                if l and not any(x in l for x in ("sync-bookmarks", "crashpad", "discord", "pgrep", "steamwebhelper", "steam", ".steam"))
            ]
            if lines:
                running.append(b_key)
        except Exception:
            pass
    return running


def make_backup(file_path, label):
    if not file_path or not os.path.exists(file_path):
        return None
    os.makedirs(BACKUP_DIR, exist_ok=True)
    base = os.path.basename(file_path)
    backup_file = os.path.join(BACKUP_DIR, f"{base}.backup_{label}_{TIMESTAMP}")
    shutil.copy2(file_path, backup_file)
    print(f"[*] Backed up {label} to {backup_file}")
    return backup_file


def extract_from_chromium(path):
    if not os.path.exists(path):
        raise FileNotFoundError(f"Bookmarks file not found at: {path}")
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    roots = data.get("roots", {})

    def parse_node(node):
        ntype = node.get("type")
        name = node.get("name", "")
        guid = node.get("guid") or str(uuid.uuid4())
        date_added = node.get("date_added", str(int(time.time() * 1000000)))
        if ntype == "folder":
            children = []
            for c in node.get("children", []):
                p = parse_node(c)
                if p:
                    children.append(p)
            return {
                "type": "folder",
                "name": name,
                "guid": guid,
                "date_added": date_added,
                "children": children
            }
        elif ntype == "url":
            return {
                "type": "url",
                "name": name,
                "url": node.get("url", ""),
                "guid": guid,
                "date_added": date_added
            }
        return None

    bb_children = []
    if "bookmark_bar" in roots and isinstance(roots["bookmark_bar"], dict):
        for c in roots["bookmark_bar"].get("children", []):
            p = parse_node(c)
            if p:
                bb_children.append(p)

    other_children = []
    if "other" in roots and isinstance(roots["other"], dict):
        for c in roots["other"].get("children", []):
            p = parse_node(c)
            if p:
                other_children.append(p)

    return {"bookmark_bar": bb_children, "other": other_children}


def extract_from_firefox(db_path):
    if not os.path.exists(db_path):
        raise FileNotFoundError(f"Firefox database not found at: {db_path}")
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    cur = conn.cursor()

    def get_children(parent_id):
        cur.execute("""
            SELECT b.id, b.type, b.title, p.url, b.dateAdded, b.guid
            FROM moz_bookmarks b
            LEFT JOIN moz_places p ON b.fk = p.id
            WHERE b.parent = ?
            ORDER BY b.position ASC
        """, (parent_id,))
        nodes = []
        for bid, btype, title, url, date_added, guid in cur.fetchall():
            if btype == 1 and url:
                nodes.append({
                    "type": "url",
                    "name": title or "",
                    "url": url,
                    "date_added": str(date_added or int(time.time() * 1000000)),
                    "guid": guid or str(uuid.uuid4())
                })
            elif btype == 2:
                nodes.append({
                    "type": "folder",
                    "name": title or "",
                    "date_added": str(date_added or int(time.time() * 1000000)),
                    "guid": guid or str(uuid.uuid4()),
                    "children": get_children(bid)
                })
        return nodes

    bb_children = get_children(3)    # Toolbar
    other_children = get_children(5) # Unfiled
    conn.close()

    return {"bookmark_bar": bb_children, "other": other_children}


def write_to_chromium(target_path, tree):
    os.makedirs(os.path.dirname(target_path), exist_ok=True)
    data = {}
    if os.path.exists(target_path):
        try:
            with open(target_path, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception:
            data = {}

    curr_id = 0
    def next_id():
        nonlocal curr_id
        curr_id += 1
        return str(curr_id)

    def convert_node(node):
        ntype = node.get("type", "folder")
        nid = next_id()
        guid = node.get("guid") or str(uuid.uuid4())
        date_added = node.get("date_added", str(int(time.time() * 1000000)))
        name = node.get("name", "")

        if ntype == "folder":
            converted_children = [convert_node(c) for c in node.get("children", [])]
            return {
                "children": converted_children,
                "date_added": date_added,
                "date_last_used": "0",
                "date_modified": str(int(time.time() * 1000000)),
                "guid": guid,
                "id": nid,
                "name": name,
                "type": "folder"
            }
        else:
            return {
                "date_added": date_added,
                "date_last_used": "0",
                "guid": guid,
                "id": nid,
                "name": name,
                "type": "url",
                "url": node.get("url", "")
            }

    bb_converted = [convert_node(c) for c in tree.get("bookmark_bar", [])]
    oth_converted = [convert_node(c) for c in tree.get("other", [])]

    roots = {
        "bookmark_bar": {
            "children": bb_converted,
            "date_added": str(int(time.time() * 1000000)),
            "date_last_used": "0",
            "date_modified": str(int(time.time() * 1000000)),
            "guid": str(uuid.uuid4()),
            "id": next_id(),
            "name": "Bookmarks bar",
            "type": "folder"
        },
        "other": {
            "children": oth_converted,
            "date_added": str(int(time.time() * 1000000)),
            "date_last_used": "0",
            "date_modified": str(int(time.time() * 1000000)),
            "guid": str(uuid.uuid4()),
            "id": next_id(),
            "name": "Other bookmarks",
            "type": "folder"
        },
        "synced": {
            "children": [],
            "date_added": str(int(time.time() * 1000000)),
            "date_last_used": "0",
            "date_modified": "0",
            "guid": str(uuid.uuid4()),
            "id": next_id(),
            "name": "Mobile bookmarks",
            "type": "folder"
        }
    }

    data["roots"] = roots
    data["version"] = 1
    # Remove stale sync metadata from the target file to avoid GUID mismatch conflicts
    data.pop("sync_metadata", None)

    with open(target_path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=3)


def write_to_firefox(db_path, tree):
    if not os.path.exists(db_path):
        raise FileNotFoundError(f"Firefox database not found at: {db_path}")

    profile_dir = os.path.dirname(db_path)

    # 1. Prevent Firefox Sync from re-enabling bookmark cloud sync in this profile
    user_js = os.path.join(profile_dir, "user.js")
    try:
        pref_line = 'user_pref("services.sync.engine.bookmarks", false);\n'
        existing = ""
        if os.path.exists(user_js):
            with open(user_js, "r", encoding="utf-8") as f:
                existing = f.read()
        if pref_line not in existing:
            with open(user_js, "a", encoding="utf-8") as f:
                f.write(pref_line)
    except Exception:
        pass

    # 2. Clear stale queued weave sync files if present
    weave_dir = os.path.join(profile_dir, "weave")
    for fname in ["toFetch/bookmarks.json", "failed/bookmarks.json"]:
        fpath = os.path.join(weave_dir, fname)
        if os.path.exists(fpath):
            try:
                os.remove(fpath)
            except Exception:
                pass

    conn = sqlite3.connect(db_path, timeout=10.0)
    cur = conn.cursor()

    now_micro = int(time.time() * 1000000)

    # 3. Tombstone recorder for Firefox Sync prevention
    def record_deletion(guid):
        if guid and len(guid) >= 12:
            cur.execute("""
                INSERT OR REPLACE INTO moz_bookmarks_deleted (guid, dateRemoved)
                VALUES (?, ?)
            """, (guid, now_micro))

    def clear_folder(fid):
        cur.execute("SELECT id, type, guid FROM moz_bookmarks WHERE parent = ?", (fid,))
        rows = cur.fetchall()
        for cid, ctype, cguid in rows:
            if ctype == 2:
                clear_folder(cid)
            record_deletion(cguid)
            cur.execute("DELETE FROM moz_bookmarks WHERE id = ?", (cid,))

    # Clean existing toolbar contents (parent = 3) and unfiled (parent = 5)
    clear_folder(3)
    clear_folder(5)

    # Clean redundant imported 'Bookmarks bar' folders in Menu (parent = 2) if any exist
    cur.execute("SELECT id, guid FROM moz_bookmarks WHERE parent = 2 AND title = 'Bookmarks bar'")
    for bar_id, bguid in cur.fetchall():
        clear_folder(bar_id)
        record_deletion(bguid)
        cur.execute("DELETE FROM moz_bookmarks WHERE id = ?", (bar_id,))

    # Clean duplicate links in Menu (parent = 2) if present
    cur.execute("SELECT id, guid, title, fk FROM moz_bookmarks WHERE parent = 2")
    menu_rows = cur.fetchall()
    seen_menu = set()
    for mid, mguid, mtitle, mfk in menu_rows:
        key = (mtitle, mfk)
        if key in seen_menu:
            record_deletion(mguid)
            cur.execute("DELETE FROM moz_bookmarks WHERE id = ?", (mid,))
        else:
            seen_menu.add(key)

    def insert_node(node, parent_id, pos):
        ntype = node.get("type")
        name = node.get("name", "")
        guid = node.get("guid", "").replace("-", "")[:12]
        if len(guid) < 12:
            guid = str(uuid.uuid4()).replace("-", "")[:12]

        if ntype == "folder":
            cur.execute("""
                INSERT INTO moz_bookmarks (type, parent, position, title, dateAdded, lastModified, guid)
                VALUES (2, ?, ?, ?, ?, ?, ?)
            """, (parent_id, pos, name, now_micro, now_micro, guid))
            new_fid = cur.lastrowid
            for cpos, child in enumerate(node.get("children", [])):
                insert_node(child, new_fid, cpos)
        elif ntype == "url":
            url = node.get("url", "")
            cur.execute("SELECT id FROM moz_places WHERE url = ?", (url,))
            row = cur.fetchone()
            if row:
                place_id = row[0]
                cur.execute("UPDATE moz_places SET foreign_count = foreign_count + 1 WHERE id = ?", (place_id,))
            else:
                place_guid = str(uuid.uuid4()).replace("-", "")[:12]
                rev_host = ""
                if "://" in url and len(url.split("/")) > 2:
                    host = url.split("/")[2].split(":")[0]
                    rev_host = ".".join(reversed(host.split("."))) + "."
                cur.execute("""
                    INSERT INTO moz_places (url, title, rev_host, visit_count, hidden, typed, frecency, guid, foreign_count)
                    VALUES (?, ?, ?, 0, 0, 0, 140, ?, 1)
                """, (url, name, rev_host, place_guid))
                place_id = cur.lastrowid

            cur.execute("""
                INSERT INTO moz_bookmarks (type, fk, parent, position, title, dateAdded, lastModified, guid)
                VALUES (1, ?, ?, ?, ?, ?, ?, ?)
            """, (place_id, parent_id, pos, name, now_micro, now_micro, guid))

    for pos, c in enumerate(tree.get("bookmark_bar", [])):
        insert_node(c, 3, pos)

    for pos, c in enumerate(tree.get("other", [])):
        insert_node(c, 5, pos)

    # Recalculate foreign_count in moz_places to maintain database integrity
    cur.execute("""
        UPDATE moz_places
        SET foreign_count = (SELECT count(*) FROM moz_bookmarks WHERE fk = moz_places.id)
    """)

    conn.commit()
    conn.close()


def generate_html(tree):
    out = [
        "<!DOCTYPE NETSCAPE-Bookmark-file-1>",
        "<!-- This is an automatically generated file.",
        "     It will be read and overwritten.",
        "     DO NOT EDIT! -->",
        '<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">',
        "<TITLE>Bookmarks</TITLE>",
        "<H1>Bookmarks</H1>",
        "<DL><p>"
    ]

    def walk_html(node, indent=4):
        sp = " " * indent
        ntype = node.get("type")
        name = html.escape(node.get("name", ""))
        if ntype == "folder":
            extra = ' PERSONAL_TOOLBAR_FOLDER="true"' if node.get("_is_toolbar") else ""
            out.append(f'{sp}<DT><H3 ADD_DATE="{int(time.time())}"{extra}>{name}</H3>')
            out.append(f'{sp}<DL><p>')
            for c in node.get("children", []):
                walk_html(c, indent + 4)
            out.append(f'{sp}</DL><p>')
        elif ntype == "url":
            u = html.escape(node.get("url", ""))
            out.append(f'{sp}<DT><A HREF="{u}" ADD_DATE="{int(time.time())}">{name}</A>')

    bb_children = tree.get("bookmark_bar", [])
    if bb_children:
        toolbar_folder = {
            "type": "folder",
            "name": "Bookmarks bar",
            "_is_toolbar": True,
            "children": bb_children
        }
        walk_html(toolbar_folder, 4)

    for c in tree.get("other", []):
        walk_html(c, 4)

    out.append("</DL><p>")
    return "\n".join(out)


BROWSER_SHORTCUTS = {
    "brave": {
        "name": "Keyboard shortcuts - Brave Browser",
        "url": "brave://settings/system/shortcuts",
    },
    "chrome": {
        "name": "Keyboard shortcuts - Chrome Browser",
        "url": "https://support.google.com/chrome/answer/157179?hl=en&co=GENIE.Platform%3DDesktop&ai1hc=1",
    },
    "firefox": {
        "name": "Keyboard shortcuts - Firefox Browser",
        "url": "https://support.mozilla.org/en-US/kb/keyboard-shortcuts-perform-firefox-tasks-quickly",
    },
}


def is_shortcut_node(node):
    if node.get("type") != "url":
        return False
    name = node.get("name", "").lower()
    url = node.get("url", "").lower()
    if "keyboard shortcuts" in name or "shortcuts -" in name:
        return True
    if url in ("brave://settings/system/shortcuts", "chrome://extensions/shortcuts"):
        return True
    if "support.mozilla.org" in url and "keyboard-shortcuts" in url:
        return True
    if "support.google.com" in url and "157179" in url:
        return True
    return False


def adapt_tree_for_browser(tree, target_browser):
    if target_browser not in BROWSER_SHORTCUTS:
        return tree
    import copy
    adapted = copy.deepcopy(tree)
    spec = BROWSER_SHORTCUTS[target_browser]

    def walk_and_adapt(node_list):
        for node in node_list:
            if is_shortcut_node(node):
                node["name"] = spec["name"]
                node["url"] = spec["url"]
            elif node.get("type") == "folder":
                walk_and_adapt(node.get("children", []))

    walk_and_adapt(adapted.get("bookmark_bar", []))
    walk_and_adapt(adapted.get("other", []))
    return adapted


def check_tree_duplicates(tree):
    seen = set()
    dups = []
    for c in tree.get("bookmark_bar", []):
        key = (c.get("type"), c.get("name"), c.get("url", ""))
        if key in seen:
            dups.append(c.get("name") or c.get("url", "untitled"))
        else:
            seen.add(key)
    return dups


def count_tree_stats(tree):
    urls, folders = 0, 0
    def walk(node):
        nonlocal urls, folders
        if node.get("type") == "folder":
            folders += 1
            for c in node.get("children", []):
                walk(c)
        elif node.get("type") == "url":
            urls += 1
    for c in tree.get("bookmark_bar", []):
        walk(c)
    for c in tree.get("other", []):
        walk(c)
    return urls, folders


def main():
    parser = argparse.ArgumentParser(
        description="Synchronizes bookmarks across Brave, Chrome, and Firefox using the system default browser (or specified browser) as authoritative.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  sync-bookmarks                 # Automatically detects system default browser and mirrors to others
  sync-bookmarks brave           # Set Brave as authoritative
  sync-bookmarks --firefox -y    # Set Firefox as authoritative without prompting
"""
    )
    parser.add_argument(
        "browser",
        nargs="?",
        choices=["brave", "chrome", "firefox"],
        help="Authoritative browser (default: auto-detected system default)."
    )
    parser.add_argument(
        "-b", "--brave",
        action="store_const",
        dest="browser_flag",
        const="brave",
        help="Shortcut to set Brave as authoritative."
    )
    parser.add_argument(
        "-c", "--chrome",
        action="store_const",
        dest="browser_flag",
        const="chrome",
        help="Shortcut to set Chrome as authoritative."
    )
    parser.add_argument(
        "-f", "--firefox",
        action="store_const",
        dest="browser_flag",
        const="firefox",
        help="Shortcut to set Firefox as authoritative."
    )
    parser.add_argument(
        "-y", "--force",
        action="store_true",
        help="Proceed without confirmation even if target browsers are running."
    )

    args = parser.parse_args()

    # 1. Determine Authoritative Browser
    auth_browser = args.browser or args.browser_flag
    detected = detect_system_default()
    if not auth_browser:
        auth_browser = detected
        if not auth_browser:
            print("[!] Could not auto-detect system default browser. Please specify one: brave, chrome, or firefox.")
            sys.exit(1)
        print(f"[*] Detected system default browser: {auth_browser.upper()}")
    else:
        print(f"[*] Authoritative browser explicitly set to: {auth_browser.upper()} (system default: {detected or 'unknown'})")

    firefox_profile = get_firefox_profile_dir()
    firefox_db = os.path.join(firefox_profile, "places.sqlite") if firefox_profile else None

    browser_paths = {
        "brave": BRAVE_PATH,
        "chrome": CHROME_PATH,
        "firefox": firefox_db
    }

    # Verify authoritative browser database exists
    auth_path = browser_paths.get(auth_browser)
    if not auth_path or not os.path.exists(auth_path):
        print(f"[!] Error: Bookmarks file for authoritative browser '{auth_browser}' does not exist at: {auth_path}")
        sys.exit(1)

    secondary_browsers = [b for b in ["brave", "chrome", "firefox"] if b != auth_browser]

    # 2. Check running processes
    running = get_running_browsers()
    running_targets = [b for b in secondary_browsers if b in running]
    if running_targets:
        print(f"[!] WARNING: Target browser(s) are currently running: {', '.join(running_targets).upper()}")
        print("    Chromium and Firefox cache bookmarks in memory. If open, their in-memory state")
        print("    may overwrite these synced bookmarks when you close them.")
        if not args.force and sys.stdin.isatty():
            confirm = input("    Proceed anyway? [y/N]: ").strip().lower()
            if confirm not in ("y", "yes"):
                print("[*] Aborted. Please close running target browsers and re-run.")
                sys.exit(0)

    print(f"\n=== Starting Bookmark Synchronization [{TIMESTAMP}] ===")
    print(f"[*] Authoritative source: {auth_browser.upper()}")

    # 3. Create Backups
    print("[*] Creating backups of existing bookmark stores...")
    make_backup(BRAVE_PATH, "brave")
    make_backup(CHROME_PATH, "chrome")
    if firefox_db:
        make_backup(firefox_db, "firefox")

    # 4. Extract authoritative tree
    print(f"[*] Extracting bookmark tree from {auth_browser.upper()}...")
    if auth_browser in ("brave", "chrome"):
        tree = extract_from_chromium(auth_path)
    elif auth_browser == "firefox":
        tree = extract_from_firefox(auth_path)
    else:
        raise ValueError(f"Unknown browser: {auth_browser}")

    dups = check_tree_duplicates(tree)
    if dups:
        print(f"[!] WARNING: Authoritative source '{auth_browser.upper()}' toolbar contains duplicate entries:")
        for d in dups[:5]:
            print(f"    - {d}")
        if len(dups) > 5:
            print(f"    ... and {len(dups) - 5} more")
        if not args.force:
            print("[!] ABORTED to prevent corrupting other browsers with duplicated bookmarks.")
            print("    Please specify a clean authoritative browser (e.g. 'sync-bookmarks brave') or use --force.")
            sys.exit(1)

    url_count, folder_count = count_tree_stats(tree)
    print(f"[*] Extracted {url_count} URLs across {folder_count} folders from {auth_browser.upper()}.")

    # Ensure authoritative browser also has its own correct shortcuts link if mis-matched
    auth_tree = adapt_tree_for_browser(tree, auth_browser)
    if auth_tree != tree:
        if auth_browser in ("brave", "chrome"):
            write_to_chromium(auth_path, auth_tree)
        elif auth_browser == "firefox":
            write_to_firefox(auth_path, auth_tree)
        tree = auth_tree

    # 5. Mirror to secondary browsers
    for target in secondary_browsers:
        target_path = browser_paths.get(target)
        if not target_path or not os.path.exists(os.path.dirname(target_path)):
            print(f"[!] Skipping {target.upper()}: directory does not exist ({target_path})")
            continue

        print(f"[*] Mirroring to {target.upper()}...")
        target_tree = adapt_tree_for_browser(tree, target)
        if target in ("brave", "chrome"):
            write_to_chromium(target_path, target_tree)
        elif target == "firefox":
            write_to_firefox(target_path, target_tree)
        print(f"    -> {target.upper()} successfully updated.")

    # 6. Generate Netscape HTML export
    os.makedirs(BACKUP_DIR, exist_ok=True)
    html_file = os.path.join(BACKUP_DIR, f"bookmarks_{TIMESTAMP}.html")
    latest_html = os.path.join(BACKUP_DIR, "bookmarks.html")
    html_content = generate_html(tree)
    with open(html_file, "w", encoding="utf-8") as f:
        f.write(html_content)
    with open(latest_html, "w", encoding="utf-8") as f:
        f.write(html_content)

    print(f"[*] Exported Netscape HTML to {html_file} and updated {latest_html}")
    print(f"=== Synchronization Complete: {url_count} bookmarks mirrored from {auth_browser.upper()} ===\n")


if __name__ == "__main__":
    main()
