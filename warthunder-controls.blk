      mouseButton:i=4
    }

    ID_SCREENSHOT{
      keyboardKey:i=183
    }

    ID_SCREENSHOT{
      keyboardKey:i=42
      keyboardKey:i=183
    }

    ID_SCREENSHOT{
      keyboardKey:i=183
    }

    elevator_rangeMax{
      keyboardKey:i=31
    }

    elevator_rangeMin{
      keyboardKey:i=17
    }

    human_uav_climb_rangeMax{
      keyboardKey:i=17
    }

    human_uav_climb_rangeMin{
      keyboardKey:i=31
    }

    human_uav_pitch_rangeMax{
      keyboardKey:i=209
    }

    human_uav_pitch_rangeMin{
      keyboardKey:i=201
    }

    human_uav_roll_rangeMax{
      keyboardKey:i=32
    }

    human_uav_roll_rangeMax{
      keyboardKey:i=205
    }

    human_uav_roll_rangeMin{
      keyboardKey:i=30
    }

    human_uav_roll_rangeMin{
      keyboardKey:i=203
    }

    human_uav_throttle_rangeMax{
      keyboardKey:i=17
    }

    human_uav_throttle_rangeMax{
      keyboardKey:i=200
    }

    human_uav_throttle_rangeMin{
      keyboardKey:i=31
    }

    human_uav_throttle_rangeMin{
      keyboardKey:i=208
    }

    human_uav_yaw_rangeMax{
      keyboardKey:i=18
    }

    human_uav_yaw_rangeMin{
      keyboardKey:i=16
    }

    throttle_rangeMax{
      keyboardKey:i=201
    }

    throttle_rangeMin{
      keyboardKey:i=209
    }
  }

  axes{
    human_uav_pitch{
      innerDeadzone:r=0
      nonlinearity:r=1
    }

    human_uav_roll{
      innerDeadzone:r=0
      nonlinearity:r=1
    }

    human_uav_throttle{
      mouseAxisId:i=7
      innerDeadzone:r=0.02
    }
  }

  params{
    holdThrottleForWEP:b=no
    mouseJoystick:b=no
  }

  deviceMapping{}
}

