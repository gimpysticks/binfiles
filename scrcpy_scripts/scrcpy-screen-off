#!/usr/bin/env bash
# Mirror and control Android phone while keeping its physical screen turned off
set -euo pipefail

echo "==> Checking for connected Android device..."
DEVICE_COUNT=$(adb devices | grep -v "List of devices" | grep -v "^$" | grep -w "device" | wc -l)

if [ "$DEVICE_COUNT" -eq 0 ]; then
    echo "❌ No authorized Android device detected. Connect device and retry."
    exit 1
fi

echo "🔋 Launching scrcpy -m 1024 with phone screen OFF (saves battery & reduces heat)..."
echo "💡 Hint: Press MOD+O in the scrcpy -m 1024 window to toggle the physical screen."
scrcpy -m 1024 --turn-screen-off --stay-awake --window-title="Android Phone (Screen Off)" "$@"
