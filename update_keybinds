#!/bin/bash
set -e

# update_keybinds: Back up active Pop!_OS COSMIC custom keybindings to ~/bin
#
# This script:
# 1. Validates and copies ~/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom
#    to /home/sticks/bin/cosmic-custom-keybindings.ron (and keybindings.ron symlink).
# 2. Automatically updates /home/sticks/bin/keybindings_reference.md with a sorted table.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=== Syncing Pop!_OS COSMIC Keybindings ==="

if [ -x "$SCRIPT_DIR/export_cosmic_keybinds.py" ]; then
    "$SCRIPT_DIR/export_cosmic_keybinds.py"
else
    echo "Error: $SCRIPT_DIR/export_cosmic_keybinds.py not found or not executable." >&2
    exit 1
fi

echo "=== Keybindings backup complete ==="
