def convert_wikilinks(text: str) -> str:
    def repl(match: re.Match) -> str:
        target = match.group(1).strip()
        label = (match.group(2) or target).strip()
        href = target if target.endswith(".md") else f"{target}.md"
        return f"[{label}]({urllib.parse.quote(href)})"

    return WIKILINK_RE.sub(repl, text)


class PromptsHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(PROMPTS_DIR), **kwargs)

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        parsed = urllib.parse.urlsplit(self.path)
        req_path = urllib.parse.unquote(parsed.path)
        query = urllib.parse.parse_qs(parsed.query)

        if req_path in ("/favicon.ico", "/favicon.svg"):
            self.send_response(200)
            self.send_header("Content-Type", "image/svg+xml")
            self.send_header("Content-Length", str(len(SVG_FAVICON)))
            self.end_headers()
            self.wfile.write(SVG_FAVICON)
            return

        if req_path == "/":
            self.send_response(302)
            self.send_header("Location", "/index.md")
            self.end_headers()
            return

        rel = req_path.lstrip("/")
        fs_path = (PROMPTS_DIR / rel).resolve()
        try:
            fs_path.relative_to(PROMPTS_DIR.resolve())
        except ValueError:
            self.send_error(403, "Forbidden")
            return

        if not fs_path.exists() and not rel.endswith(".md"):
            md_candidate = (PROMPTS_DIR / f"{rel}.md").resolve()
            if md_candidate.is_file():
                fs_path = md_candidate

        if fs_path.is_file() and fs_path.suffix.lower() == ".md":
            raw_text = fs_path.read_text(encoding="utf-8", errors="replace")
            if query.get("raw") == ["1"]:
                data = raw_text.encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return

            meta_html = ""
            m = FRONTMATTER_RE.match(raw_text)
            if m:
                meta_content = html.escape(m.group(1).strip())
                meta_html = f'<div class="meta">{meta_content}</div>'
                raw_text = raw_text[m.end():]

            processed = convert_wikilinks(raw_text)
            body_html = markdown.markdown(
                processed,
                extensions=["extra", "toc", "sane_lists"],
            )
            page = HTML_TEMPLATE.format(
                title=html.escape(fs_path.stem),
                meta_block=meta_html,
                body=body_html,
            ).encode("utf-8")

            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(page)))
            self.end_headers()
            self.wfile.write(page)
            return

        return super().do_GET()

    def log_message(self, format, *args):
        pass


class ReusableThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    allow_reuse_address = True
    daemon_threads = True


def main():
    os.chdir(PROMPTS_DIR)
    with ReusableThreadingHTTPServer((HOST, PORT), PromptsHandler) as httpd:
        httpd.serve_forever()


if __name__ == "__main__":
    main()
