#!/usr/bin/env python3
"""Lightweight local HTTP server for $PROMPTS_LIB with Markdown-to-HTML rendering."""

import html
import http.server
import os
import re
import socketserver
import urllib.parse
from pathlib import Path

import markdown

PROMPTS_DIR = Path(
    os.environ.get("PROMPTS_LIB")
    or os.environ.get("prompts_Lib")
    or (Path.home() / "Documents" / "Prompt_library")
).expanduser()
HOST = "127.0.0.1"
PORT = 8766

FRONTMATTER_RE = re.compile(r"\A---\s*\n(.*?)\n---\s*\n", re.DOTALL)
WIKILINK_RE = re.compile(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]")

SVG_FAVICON = b"""<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <rect width="64" height="64" rx="14" fill="#1e293b"/>
  <path d="M20 14h16c8.8 0 14 4.8 14 12s-5.2 12-14 12H27v12h-7V14zm7 6v12h9c4.6 0 7-2.2 7-6s-2.4-6-7-6h-9z" fill="#a78bfa"/>
</svg>"""

HTML_TEMPLATE = """<!DOCTYPE html>
