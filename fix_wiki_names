#!/bin/bash

# Rename the Home.md file to proper wiki name
if [ -f "202510090051-202510090051-Home.md" ]; then
    mv "202510090051-202510090051-Home.md" "index.md"
    echo "Renamed Home page"
fi

# Create a simple index of files for the wiki
echo "# Wiki Index" > index.md
echo "" >> index.md
echo "This wiki contains the following pages:" >> index.md
echo "" >> index.md

# Add all markdown files except index.md to the index
for file in *.md; do
    if [ "$file" != "index.md" ]; then
        # Extract a clean title from filename
        title=$(echo "$file" | sed 's/^[0-9]*-[0-9]*-//g' | sed 's/\.md$//g' | tr '_' ' ')
        echo "- [$title]($file)" >> index.md
    fi
done

echo "Updated index.md with file index"