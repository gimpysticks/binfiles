#!/bin/bash
# Usage: MJ-Linktree [hashtag ...]
# Any arguments passed are appended as hashtags to the copied text.
# A leading '#' on arguments is optional (both "foo" and "#foo" work).

extra=""
for tag in "$@"; do
    # Strip any leading '#' so we can normalize to a single '#'.
    tag="${tag#\#}"
    [ -z "$tag" ] && continue
    extra+=" #${tag}"
done

echo -n "Links in the bio #midjourney @gimpysticks${extra} " | xclip -selection clipboard -i
