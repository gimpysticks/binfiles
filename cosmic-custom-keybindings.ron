// =============================================================================
// Pop!_OS COSMIC Custom Keybindings (RON Format)
// Repaired: 2026-09-27 14:09
//
// Changes from the previously corrupted live file:
// - Fixed truncated F12 entry that made the whole file fail to parse
// - Removed stray "TildaZ_0" duplicate that conflicted with F12
// - War Thunder / Steam now use the native `steam` command (flatpak Steam
//   has been uninstalled and replaced by the deb/native install)
//
// Removed entirely - confirmed NOT installed on this system:
//   WiFi (gnome-control-center), Beeper (AppImage file missing),
//   Glances, OpenRGB (flatpak), polychromatic-tray-applet, Hypnotix,
//   toggle_nerd_dict (depends on missing nerd-dictation)
//
// Removed entirely - explicitly requested by user (both actually installed):
//   Guake (F12) - dpkg shows installed and running as a background daemon;
//     removing this binding only removes the F12 toggle, not the process.
//   Digikam (Ctrl+Alt+d) - installed via flatpak (org.kde.digikam)
//
// Backups of the prior corrupted live file:
//   /home/sticks/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom.corrupted-backup-20260927-100423
//   /home/sticks/bin/custom-live-CORRUPTED-backup-20260927-100423.ron
//
// File Location: ~/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom
// Repository Copy: /home/sticks/bin/cosmic-custom-keybindings.ron
// Markdown Reference: /home/sticks/bin/keybindings_reference.md
//
// NOTE:
// Pop!_OS COSMIC default keybindings (e.g. Super+t for cosmic-term,
// Super+f for cosmic-files, workspace switching, tiling) are preserved
// and NOT overwritten.
// =============================================================================

{
    (
        modifiers: [
            Alt,
        ],
        key: "Left",
        description: Some("variety Previous"),
    ): Spawn("/usr/bin/variety --previous"),

    (
        modifiers: [
            Alt,
        ],
        key: "Right",
        description: Some("Variety Next"),
    ): Spawn("/usr/bin/variety --next"),

    (
        modifiers: [
            Alt,
            Shift,
        ],
        key: "s",
        description: Some("Standard Notes"),
    ): Spawn("xdg-open https://app.standardnotes.com/"),

    (
        modifiers: [
