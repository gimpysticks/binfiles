#!/bin/bash
set -e # Exit on error

# Display usage information
show_usage() {
  echo "Usage: $(basename "$0") [OPTIONS]"
  echo "Opens URLs listed in a bookmarks file using a tmux session."
  echo
  echo "Options:"
  echo "  -f, --file FILE    Use custom bookmarks file (default: ~/Documents/default_bookmarks.url)"
  echo "  -s, --session NAME Use custom tmux session name (default: aiurls)"
  echo "  -h, --help         Show this help message and exit"
  echo
  echo "Format of bookmarks file: Each line should contain 'name|url'"
  exit 0
}

# Check for required commands
if ! command -v tmux &>/dev/null; then
  echo "Error: Required command 'tmux' not found. Please install it and try again."
  exit 1
fi

if ! command -v gio &>/dev/null && ! command -v xdg-open &>/dev/null; then
  echo "Error: Neither 'gio' nor 'xdg-open' found. Please install an opener and try again."
  exit 1
fi

# Check for keyboard automation tool
if ! python3 -c "import evdev" &>/dev/null && ! command -v wtype &>/dev/null && ! command -v ydotool &>/dev/null; then
  echo "Warning: No Wayland keyboard automation tool (python3-evdev, wtype, or ydotool) found. Tab navigation may not work." >&2
fi

# Define default session name
SESSION_NAME="aiurls"

# Default bookmarks file
AIURLS_BOOKMARKS_FILE="$HOME/Documents/bookmarks/ai.urls"
BOOKMARKS_FILE="$AIURLS_BOOKMARKS_FILE"

switch_to_first_tab() {
  # 1. Preferred on Wayland/COSMIC: kernel-level /dev/uinput via python3-evdev
  #    wtype's zwp_virtual_keyboard_v1 custom keymap is ignored by Chromium/Brave under COSMIC.
  if [ -w /dev/uinput ] && command -v python3 &>/dev/null; then
    if python3 -c '
import time
from evdev import UInput, ecodes as e

with UInput({e.EV_KEY: [e.KEY_LEFTCTRL, e.KEY_1]}) as ui:
    # Allow compositor/libinput to register the new virtual keyboard device
    time.sleep(0.3)
    ui.write(e.EV_KEY, e.KEY_LEFTCTRL, 1)
    ui.syn()
    time.sleep(0.05)
    ui.write(e.EV_KEY, e.KEY_1, 1)
    ui.syn()
    time.sleep(0.05)
    ui.write(e.EV_KEY, e.KEY_1, 0)
    ui.syn()
    time.sleep(0.05)
    ui.write(e.EV_KEY, e.KEY_LEFTCTRL, 0)
    ui.syn()
    time.sleep(0.1)
' 2>/dev/null; then
      return 0
    fi
  fi

  # 2. Fallback Wayland tools (ydotool / wtype)
  if command -v ydotool &>/dev/null; then
    ydotool key 29:1 2:1 2:0 29:0 2>/dev/null && return 0
  fi
  if command -v wtype &>/dev/null; then
    wtype -M ctrl -s 100 -k 1 -s 100 -m ctrl 2>/dev/null || true
  fi
}

run_url_opener() {
  local bookmarks_file="${BOOKMARKS_FILE:-$AIURLS_BOOKMARKS_FILE}"
  echo "Processing URLs from: $bookmarks_file"

  # Under COSMIC desktop, xdg-open defaults to a blocking generic mode.
  # Prepending GNOME informs xdg-open to use gio/desktop portal asynchronously.
  if [[ "${XDG_CURRENT_DESKTOP:-}" == *"COSMIC"* && "${XDG_CURRENT_DESKTOP:-}" != *"GNOME"* ]]; then
    export XDG_CURRENT_DESKTOP="GNOME:$XDG_CURRENT_DESKTOP"
  fi

  local first_url=true

  # Process URLs
  cut -d'|' -f2 "$bookmarks_file" | while IFS= read -r url; do
    # Strip carriage returns and leading/trailing whitespace
    url="${url#"${url%%[![:space:]]*}"}"
    url="${url%"${url##*[![:space:]]}"}"
    url="${url//$'\r'/}"

    # Skip empty lines and comment lines
    if [ -n "$url" ] && [[ ! "$url" =~ ^# ]]; then
      echo "Opening: $url"
      # Launch completely detached from the tmux terminal so SIGHUP won't kill the browser on session exit
      if command -v gio &>/dev/null; then
        setsid -f gio open "$url" </dev/null >/dev/null 2>&1 || gio open "$url"
      else
        setsid -f xdg-open "$url" </dev/null >/dev/null 2>&1 || xdg-open "$url"
      fi

      if [ "$first_url" = true ]; then
        sleep 2 # gives browser initial launch time if cold-starting
        first_url=false
      else
        sleep 1 # gives browser time to open each tab
      fi
    fi
  done

  # Wait for the last tab to open and settle before switching to the first tab
  sleep 1.5
  switch_to_first_tab
  sleep 0.5
}

# Internal execution mode when invoked inside tmux
if [ "$1" = "--internal-run" ]; then
  BOOKMARKS_FILE="$2"
  run_url_opener
  exit 0
fi

# Parse command line arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
  -f | --file)
    BOOKMARKS_FILE="$2"
    shift 2
    ;;
  -s | --session)
    SESSION_NAME="$2"
    shift 2
    ;;
  -h | --help)
    show_usage
    ;;
  *)
    echo "Unknown option: $1"
    show_usage
    ;;
  esac
done

# Check if the bookmarks file exists
if [ ! -f "$BOOKMARKS_FILE" ]; then
  echo "Error: Bookmarks file not found: $BOOKMARKS_FILE"
  exit 1
fi

# Kill existing session if it's running
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  echo "Killing existing session: $SESSION_NAME"
  if ! tmux kill-session -t "$SESSION_NAME"; then
    echo "Warning: Failed to kill existing session. Continuing anyway..."
  fi
fi

# Forward display and session environment variables into the tmux session
tmux_env_args=()
for var in WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE XDG_CURRENT_DESKTOP; do
  if [ -n "${!var:-}" ]; then
    tmux_env_args+=(-e "$var=${!var}")
  fi
done

# Create a new tmux session running the URL opener directly
SCRIPT_PATH="$(command -v "$0" 2>/dev/null || realpath "$0")"
if ! tmux new-session -d -s "$SESSION_NAME" "${tmux_env_args[@]}" bash "$SCRIPT_PATH" --internal-run "$BOOKMARKS_FILE"; then
  echo "Error: Failed to create new tmux session"
  exit 1
fi

exit 0
