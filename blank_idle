#!/bin/bash
# blank_idle - Set screen idle/blank timeout (supports Pop!_OS COSMIC and GNOME)

idle_secs="${1:-300}"

# COSMIC desktop support
COSMIC_IDLE_DIR="$HOME/.config/cosmic/com.system76.CosmicIdle/v1"
if [ -d "$COSMIC_IDLE_DIR" ] || [ "${XDG_CURRENT_DESKTOP:-}" = "COSMIC" ]; then
    mkdir -p "$COSMIC_IDLE_DIR"
    if [ "$idle_secs" -eq 0 ]; then
        echo "None" > "$COSMIC_IDLE_DIR/screen_off_time"
        echo "COSMIC screen blank timeout disabled."
    else
        ms=$(( idle_secs * 1000 ))
        echo "Some($ms)" > "$COSMIC_IDLE_DIR/screen_off_time"
        echo "COSMIC screen blank timeout set to ${idle_secs}s (${ms}ms)."
    fi
fi

# GNOME fallback
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.session idle-delay "$idle_secs" 2>/dev/null || true
fi
