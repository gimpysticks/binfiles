#!/bin/sh
set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "This script must be run as root (e.g. sudo $0)"
    exit 1
fi

cat << 'EOF' > /etc/systemd/system/backup.timer
[Unit]
Description=Daily Backup Timer at 4:00 AM

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=false

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl restart backup.timer

echo "backup.timer updated successfully. Status:"
systemctl status backup.timer --no-pager
