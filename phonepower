#!/usr/bin/env bash
# ==============================================================================
# phonepower - Check phone battery status
# Supports: KDE Connect, upower (Bluetooth/USB), GSConnect, and ADB
# ==============================================================================

# 1. Try KDE Connect (native Pop!_OS COSMIC / Linux desktop)
if command -v gdbus &> /dev/null; then
    KDE_DEVICES=$(gdbus call --session --dest org.kde.kdeconnect \
        --object-path /modules/kdeconnect \
        --method org.kde.kdeconnect.daemon.devices true false 2>/dev/null | grep -oP "'\K[a-f0-9]+(?=')")

    for dev in $KDE_DEVICES; do
        DEV_NAME=$(gdbus call --session --dest org.kde.kdeconnect \
            --object-path "/modules/kdeconnect/devices/$dev" \
            --method org.freedesktop.DBus.Properties.Get org.kde.kdeconnect.device name 2>/dev/null | grep -oP "'\K[^']+(?=')")

        BATTERY_INFO=$(gdbus call --session --dest org.kde.kdeconnect \
            --object-path "/modules/kdeconnect/devices/$dev/battery" \
            --method org.freedesktop.DBus.Properties.GetAll org.kde.kdeconnect.device.battery 2>/dev/null)

        if [ -n "$BATTERY_INFO" ]; then
            PERCENTAGE=$(echo "$BATTERY_INFO" | grep -oP "'charge': <\K\d+(?=>)")
            CHARGING=$(echo "$BATTERY_INFO" | grep -q "'isCharging': <true>" && echo " (charging)" || echo "")
            echo "Device: ${DEV_NAME:-$dev}"
            echo "Battery: ${PERCENTAGE}%${CHARGING}"
            exit 0
        fi
    done
fi

# 2. Try GSConnect (GNOME Shell extension fallback)
if command -v gdbus &> /dev/null; then
    DEVICES=$(gdbus call --session --dest org.gnome.Shell.Extensions.GSConnect \
        --object-path /org/gnome/Shell/Extensions/GSConnect \
        --method org.freedesktop.DBus.ObjectManager.GetManagedObjects 2>/dev/null)

    if [ -n "$DEVICES" ]; then
        DEVICE_ID=$(echo "$DEVICES" | grep -oP "Device/\K[a-f0-9]+(?='.*'Connected': <true>)" | head -1)
        if [ -n "$DEVICE_ID" ]; then
            BATTERY_INFO=$(gdbus call --session --dest org.gnome.Shell.Extensions.GSConnect \
                --object-path /org/gnome/Shell/Extensions/GSConnect/Device/$DEVICE_ID \
                --method org.gtk.Actions.Describe battery 2>/dev/null)

            if [ -n "$BATTERY_INFO" ]; then
                PERCENTAGE=$(echo "$BATTERY_INFO" | grep -oP ', \K\d+(?=, \d+\)>)')
                ICON=$(echo "$BATTERY_INFO" | grep -oP "'\K[^']+(?=', \d+, \d+)")
                CHARGING=$(echo "$BATTERY_INFO" | grep -q "<(true" && echo " (charging)" || echo "")
                echo "Battery: ${PERCENTAGE}%${CHARGING}"
                echo "Icon: ${ICON}"
                exit 0
            fi
        fi
    fi
fi

# 3. Try upower (Bluetooth / USB)
PHONE_DEVICE=$(upower -e 2>/dev/null | grep -E 'phone|moto' | head -1)
if [ -n "$PHONE_DEVICE" ]; then
    echo "Found via upower ($PHONE_DEVICE):"
    upower -i "$PHONE_DEVICE" | grep -E 'model|percentage|state'
    exit 0
fi

# 4. Try ADB if available
if command -v adb &> /dev/null; then
    if adb devices 2>/dev/null | grep -q "device$"; then
        echo "Found via ADB:"
        adb shell dumpsys battery | grep -E 'level|status'
        exit 0
    fi
fi

echo "No phone battery detected. Make sure it's connected via:"
echo "  - KDE Connect (paired and connected)"
echo "  - Bluetooth (paired and connected)"
echo "  - USB with ADB debugging enabled"
exit 1
