#!/bin/bash

# --- Configuration ---
# Set the base directory for outputs to be within ~/bin
OUTPUT_BASE_DIR="$HOME/bin"
BACKUP_DIR_NAME="reinstall_prep_$(date +%Y%m%d_%H%M%S)"
OUTPUT_DIR="${1:-$OUTPUT_BASE_DIR/$BACKUP_DIR_NAME}"

echo "Starting comprehensive installed software inventory..."
echo "Creating backup directory: $OUTPUT_DIR"
mkdir -p "$OUTPUT_DIR"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -x "$SCRIPT_DIR/all-installed" ]; then
    "$SCRIPT_DIR/all-installed" --export "$OUTPUT_DIR"
else
    python3 "$SCRIPT_DIR/all-installed" --export "$OUTPUT_DIR"
fi

# Update symlinks in ~/bin to point to the latest reinstall scripts
if [ -f "$OUTPUT_DIR/reinstall_apps" ]; then
    ln -sf "$OUTPUT_DIR/reinstall_apps" "$SCRIPT_DIR/reinstall_apps"
fi
if [ -f "$OUTPUT_DIR/reinstall_apps.sh" ]; then
    ln -sf "$OUTPUT_DIR/reinstall_apps.sh" "$SCRIPT_DIR/reinstall_apps.sh"
elif [ -f "$OUTPUT_DIR/reinstall_apps" ]; then
    ln -sf "$OUTPUT_DIR/reinstall_apps" "$SCRIPT_DIR/reinstall_apps.sh"
fi

echo -e "\n--- Script Finished ---"
echo "All lists, manifest, and restore scripts are prepared in: $OUTPUT_DIR"
echo "Copy this directory to external storage before reinstalling your OS!"
