#!/bin/bash

# Script to update ~/zets/index.md with current directory contents (newest edits first)
# Usage: update_zets

set -euo pipefail

ZETSWIKI_DIR="$HOME/zets"
HOME_MD="$ZETSWIKI_DIR/index.md"

if [[ ! -d "$ZETSWIKI_DIR" ]]; then
    echo "Error: $ZETSWIKI_DIR directory does not exist" >&2
    exit 1
fi

echo "Updating index.md with current directory contents (latest edits at the top)..."

temp_file=$(mktemp)
count=0

{
    printf -- '---\ncreated: %s\n---\n\n\n# Generated Links\n\n' "$(date '+%Y-%m-%d')"
    while IFS=$'\t' read -r _ts fname; do
        link="${fname// /%20}"
        link="${link//#/%23}"
        link="${link//\'/%27}"
        printf -- '- [%s](%s)\n' "${fname%.md}" "$link"
        count=$(( count + 1 ))
    done < <(find "$ZETSWIKI_DIR" -maxdepth 1 -name '*.md' -not -name 'index.md' -printf '%T@\t%f\n' | sort -rn)
} > "$temp_file"

if cp "$temp_file" "$HOME_MD"; then
    rm -f "$temp_file"
    echo "index.md updated successfully!"
    echo "Total files indexed: $count (sorted by modification time, newest first)"
else
    echo "Error: Failed to update index.md" >&2
    rm -f "$temp_file"
    exit 1
fi