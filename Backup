#!/bin/sh
# $1 = user
# Backs up /home/$1 to /mnt/backup
#
# DESTINATION is currently hardcoded to /mnt/backup.
# To make it configurable at runtime, change the argument check and DEST lines to:
#
#   if [ $# -lt 2 ]; then
#       echo "USAGE: '$0' username destinationpath"
#       exit 1
#   fi
#   DEST="$2"
#
# USERNAME ($1) is already passed as an argument.
# If you ever want to hardcode it instead, replace "/home/$1/" in the rsync
# command with "/home/sticks/" and remove the argument check entirely.

if [ $# -lt 1 ]
    then
        echo "USAGE: '$0' username [--force]"
        exit 1
fi

# Restrict execution to 4:00 AM unless --force is specified
FORCE=0
for arg in "$@"; do
    [ "$arg" = "--force" ] && FORCE=1
done

CURRENT_HOUR=$(date +%H)
if [ "$CURRENT_HOUR" != "04" ] && [ "$FORCE" -ne 1 ]; then
    echo "Notice: Backup is restricted to run only at 4:00 AM (current hour: $CURRENT_HOUR). Aborting."
    exit 0
fi

DEST="/mnt/backup"   # To pass destination at runtime, replace with: DEST="$2"
LOG_DIR="$DEST/logs"
[ -z "$BACKUP_HOOKWEB" ] && . "/home/sticks/.envrc"
WEBHOOK_URL="$BACKUP_HOOKWEB"

# Verify mount point is available
if ! mountpoint -q "$DEST"; then
    echo "ERROR: $DEST is not mounted. Aborting."
    failmsg="$1 on $(hostname) Backup script FAILED: $DEST is not mounted $(date +%c)"
    MESSAGE="$failmsg"
    PAYLOAD='{"content": "'"$MESSAGE"'"}'
    [ -n "$WEBHOOK_URL" ] && curl -s -X POST -H "Content-Type: application/json" -d "$PAYLOAD" "$WEBHOOK_URL"
    exit 1
fi

sleep 5

# Ensure log folder exists
mkdir -p "$LOG_DIR"

#-------Start Notify--------------------------------------------------------------
beginmsg="$1 on $(hostname) Backup script Started $(date +%c)"
MESSAGE="$beginmsg"
PAYLOAD='{"content": "'"$MESSAGE"'"}'
curl -s -X POST -H "Content-Type: application/json" -d "$PAYLOAD" "$WEBHOOK_URL"

#-------Run Script--------------------------------------------------------------
# exFAT compatible flags (-rltDv instead of -aAXHv)
# Using nice and ionice (idle class) so backup yields CPU and disk I/O to interactive applications
nice -n 19 ionice -c 3 rsync -rltDv --info=progress2 --delete \
  --exclude='.cache' \
  --exclude='.cache/*' \
  --exclude='.local/share/Trash/*' \
  --exclude='.mozilla/firefox/*/Cache*/*' \
  --exclude='.mozilla/firefox/*/cache*/*' \
  --exclude='.thumbnails/*' \
  --exclude='.npm/*' \
  --exclude='node_modules/*' \
  --exclude='.yarn/*' \
  --exclude='*.tmp' \
  --exclude='*.temp' \
  --exclude='target/debug/*' \
  --exclude='target/release/*' \
  --exclude='.cargo/registry/*' \
  --exclude='.cargo/git/*' \
  --exclude='.rustup/toolchains/*/lib/*' \
  --exclude='.wine/*' \
  --exclude='snap/*' \
  --exclude='.snapd/*' \
  --exclude='.steam' \
  --exclude='.steam/*' \
  --exclude='.local/share/Steam' \
  --exclude='.local/share/Steam/*' \
  --exclude='.local/share/flatpak' \
  --exclude='.local/share/flatpak/*' \
  --exclude='.var/app/com.valvesoftware.Steam' \
  --exclude='.var/app/com.valvesoftware.Steam/*' \
  --exclude="$DEST" \
"/home/$1/" "$DEST" >> "$LOG_DIR/$(hostname)-$1-$(date +%Y%m%d%H%M).log" 2>&1

#-------End Notify--------------------------------------------------------------
endmsg="$1 on $(hostname) Backup script completed $(date +%c)"
MESSAGE="$endmsg"
PAYLOAD='{"content": "'"$MESSAGE"'"}'
curl -s -X POST -H "Content-Type: application/json" -d "$PAYLOAD" "$WEBHOOK_URL"
