#!/usr/bin/env python3
"""
all-installed - Comprehensive inventory of installed programs regardless of source or package type.

Detects:
  - Desktop GUI Applications (.desktop files across system, user, flatpak, snap)
  - Flatpak Applications (flathub, system, user)
  - Snap Applications (user & system snaps)
  - AppImages (scans ~/Applications, ~/.local/opt, ~/.local/bin, ~/bin, $HOME)
  - APT / DPKG (manually installed vs full selections)
  - Cargo Packages (Rust crates & binaries)
  - NPM Global Packages (Node.js global tools)
  - Python / Pip User Packages & CLI tools (pip --user, pipx)
  - Go Binaries (~/go/bin)
  - Local User Scripts (~/bin, ~/.local/bin)
"""

import os
import sys
import glob
import json
import shutil
import argparse
import subprocess
from datetime import datetime

# ANSI Colors
USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

def color(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else str(text)

def bold(text): return color(text, "1")
def green(text): return color(text, "32")
def yellow(text): return color(text, "33")
def blue(text): return color(text, "34")
def magenta(text): return color(text, "35")
def cyan(text): return color(text, "36")
def dim(text): return color(text, "2")
def red(text): return color(text, "31")

def run_cmd(cmd, timeout=15):
    try:
        res = subprocess.run(
            cmd,
            shell=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout
        )
        return res.stdout.strip()
    except Exception:
        return ""

def command_exists(cmd):
    return shutil.which(cmd) is not None

def parse_desktop_file(filepath):
    try:
        data = {}
        in_entry = False
        with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("[") and line.endswith("]"):
                    in_entry = (line == "[Desktop Entry]")
                    continue
                if in_entry and "=" in line:
                    k, v = line.split("=", 1)
                    k = k.strip()
                    if k not in data:
                        data[k] = v.strip()
        return data
    except Exception:
        return {}

def collect_desktop_apps():
    desktop_dirs = [
        os.path.expanduser("~/.local/share/applications"),
        "/usr/share/applications",
        "/usr/local/share/applications",
        "/var/lib/flatpak/exports/share/applications",
        os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
        "/var/lib/snapd/desktop/applications"
    ]
    apps = {}
    for d in desktop_dirs:
        if not os.path.isdir(d):
            continue
        for p in glob.glob(os.path.join(d, "*.desktop")):
            base = os.path.basename(p)
            info = parse_desktop_file(p)
            if not info or info.get("NoDisplay", "").lower() == "true":
                continue
            name = info.get("Name", "").strip()
            if not name or base in apps:
                continue

            # Classify source of desktop entry
            exec_str = info.get("Exec", "").strip()
            source = "System / APT"
            if "flatpak" in d or "flatpak run" in exec_str:
                source = "Flatpak"
            elif "snap" in d or "/snap/" in exec_str:
                source = "Snap"
            elif ".local" in d:
                source = "User / Custom"
            elif ".AppImage" in exec_str or ".appimage" in exec_str:
                source = "AppImage"

            apps[base] = {
                "name": name,
                "exec": exec_str,
                "file": p,
                "source": source,
                "comment": info.get("Comment", ""),
                "categories": info.get("Categories", "")
            }
    return sorted(apps.values(), key=lambda x: x["name"].lower())

def collect_flatpaks():
    if not command_exists("flatpak"):
        return []
    out = run_cmd("flatpak list --app --columns=application,name,version,origin")
    items = []
    for line in out.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        if len(parts) >= 2:
            app_id = parts[0].strip()
            name = parts[1].strip() if len(parts) > 1 else app_id
            ver = parts[2].strip() if len(parts) > 2 else ""
            origin = parts[3].strip() if len(parts) > 3 else ""
            items.append({
                "id": app_id,
                "name": name,
                "version": ver,
                "origin": origin
            })
    return sorted(items, key=lambda x: x["name"].lower())

def collect_snaps():
    if not command_exists("snap"):
        return []
    out = run_cmd("snap list")
    items = []
    lines = out.splitlines()
    if len(lines) > 1:
        for line in lines[1:]:
            parts = line.split()
            if len(parts) >= 2:
                name = parts[0]
                version = parts[1]
                tracking = parts[3] if len(parts) > 3 else ""
                publisher = parts[4] if len(parts) > 4 else ""
                is_core = name in ["bare", "core", "core18", "core20", "core22", "core24", "snapd"]
                items.append({
                    "name": name,
                    "version": version,
                    "tracking": tracking,
                    "publisher": publisher,
                    "is_core": is_core
                })
    return sorted(items, key=lambda x: (x["is_core"], x["name"].lower()))

def collect_appimages():
    home = os.path.expanduser("~")
    search_dirs = [
        os.path.join(home, "Applications"),
        os.path.join(home, ".local", "opt"),
        os.path.join(home, ".local", "bin"),
        os.path.join(home, "bin"),
        "/opt",
        "/usr/local/bin"
    ]
    found = set()

    for d in search_dirs:
        if os.path.isdir(d):
            for root, _, files in os.walk(d):
                for f in files:
                    if f.lower().endswith(".appimage"):
                        found.add(os.path.realpath(os.path.join(root, f)))

    # Also search home directory top level and visible subdirectories (depth <= 2)
    for root, dirs, files in os.walk(home):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in ["node_modules", "target", "build", "dist"]]
        depth = root[len(home):].count(os.sep)
        if depth >= 2:
            dirs.clear()
        for f in files:
            if f.lower().endswith(".appimage"):
                p = os.path.realpath(os.path.join(root, f))
                found.add(p)

    items = []
    for p in sorted(found):
        if os.path.isfile(p):
            stat = os.stat(p)
            size_mb = stat.st_size / (1024 * 1024)
            executable = os.access(p, os.X_OK)
            items.append({
                "path": p,
                "name": os.path.basename(p),
                "size_mb": round(size_mb, 1),
                "executable": executable
            })
    return sorted(items, key=lambda x: x["name"].lower())

def collect_apt_manual():
    if not command_exists("apt-mark"):
        return []
    out = run_cmd("apt-mark showmanual")
    return sorted([line.strip() for line in out.splitlines() if line.strip()])

def collect_apt_selections():
    if not command_exists("dpkg"):
        return []
    out = run_cmd("dpkg --get-selections")
    items = []
    for line in out.splitlines():
        if "deinstall" not in line and line.strip():
            pkg = line.split()[0]
            items.append(pkg)
    return sorted(items)

def collect_cargo():
    if not command_exists("cargo"):
        return []
    out = run_cmd("cargo install --list")
    crates = []
    current_crate = None
    for line in out.splitlines():
        if line and not line.startswith(" "):
            parts = line.split()
            current_crate = {"name": parts[0], "version": parts[1] if len(parts) > 1 else "", "binaries": []}
            crates.append(current_crate)
        elif line.strip() and current_crate:
            current_crate["binaries"].append(line.strip())
    return crates

def collect_npm_global():
    if not command_exists("npm"):
        return []
    out = run_cmd("npm list -g --depth=0 --json")
    items = []
    if out:
        try:
            data = json.loads(out)
            deps = data.get("dependencies", {})
            for pkg, info in deps.items():
                items.append({
                    "name": pkg,
                    "version": info.get("version", "")
                })
        except Exception:
            pass
    return sorted(items, key=lambda x: x["name"].lower())

def collect_python_user():
    items = []
    # Check pip user packages
    pip_cmd = "pip" if command_exists("pip") else ("pip3" if command_exists("pip3") else None)
    if pip_cmd:
        out = run_cmd(f"{pip_cmd} list --user --format=json")
        if out:
            try:
                for entry in json.loads(out):
                    items.append({
                        "name": entry.get("name"),
                        "version": entry.get("version"),
                        "source": "pip --user"
                    })
            except Exception:
                pass
    # Check pipx
    if command_exists("pipx"):
        out = run_cmd("pipx list --json")
        if out:
            try:
                data = json.loads(out)
                for venv, info in data.get("venvs", {}).items():
                    items.append({
                        "name": venv,
                        "version": info.get("metadata", {}).get("main_package", {}).get("package_version", ""),
                        "source": "pipx"
                    })
            except Exception:
                pass
    return sorted(items, key=lambda x: x["name"].lower())

def collect_go_binaries():
    home = os.path.expanduser("~")
    go_bin = os.path.join(home, "go", "bin")
    if not os.path.isdir(go_bin):
        return []
    items = []
    for f in os.listdir(go_bin):
        p = os.path.join(go_bin, f)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            items.append({
                "name": f,
                "path": p
            })
    return sorted(items, key=lambda x: x["name"].lower())

def collect_local_scripts():
    home = os.path.expanduser("~")
    bin_dir = os.path.join(home, "bin")
    if not os.path.isdir(bin_dir):
        return []
    items = []
    for f in os.listdir(bin_dir):
        p = os.path.join(bin_dir, f)
        if os.path.isfile(p) and os.access(p, os.X_OK) and not f.startswith("."):
            items.append(f)
    return sorted(items)

def collect_all_data():
    return {
        "timestamp": datetime.now().isoformat(),
        "desktop_apps": collect_desktop_apps(),
        "flatpaks": collect_flatpaks(),
        "snaps": collect_snaps(),
        "appimages": collect_appimages(),
        "cargo": collect_cargo(),
        "npm_global": collect_npm_global(),
        "python_user": collect_python_user(),
        "go_binaries": collect_go_binaries(),
        "apt_manual": collect_apt_manual(),
        "apt_selections": collect_apt_selections(),
        "local_scripts": collect_local_scripts()
    }

