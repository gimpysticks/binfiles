def search_all(data, query):
    q = query.lower()
    matches = []

    for app in data["desktop_apps"]:
        if q in app["name"].lower() or q in app["exec"].lower() or q in app.get("comment", "").lower():
            matches.append(("Desktop GUI", app["name"], f"Source: {app['source']} | Exec: {app['exec']}"))

    for f in data["flatpaks"]:
        if q in f["name"].lower() or q in f["id"].lower():
            matches.append(("Flatpak", f"{f['name']} ({f['id']})", f"Version: {f['version']} | {f['origin']}"))

    for s in data["snaps"]:
        if q in s["name"].lower():
            matches.append(("Snap", s["name"], f"Version: {s['version']} | Tracking: {s['tracking']}"))

    for a in data["appimages"]:
        if q in a["name"].lower() or q in a["path"].lower():
            matches.append(("AppImage", a["name"], f"Path: {a['path']} ({a['size_mb']} MB)"))

    for c in data["cargo"]:
        if q in c["name"].lower() or any(q in b.lower() for b in c["binaries"]):
            matches.append(("Cargo", c["name"], f"Version: {c['version']} | Binaries: {', '.join(c['binaries'])}"))

    for n in data["npm_global"]:
        if q in n["name"].lower():
            matches.append(("NPM Global", n["name"], f"Version: {n['version']}"))

    for p in data["python_user"]:
        if q in p["name"].lower():
            matches.append(("Python", p["name"], f"Version: {p['version']} ({p['source']})"))

    for g in data["go_binaries"]:
        if q in g["name"].lower():
            matches.append(("Go Binary", g["name"], f"Path: {g['path']}"))

    for s in data["local_scripts"]:
        if q in s.lower():
            matches.append(("Local Script", s, f"Location: ~/bin/{s}"))

    for p in data["apt_manual"]:
        if q in p.lower():
            matches.append(("APT (Manual)", p, "dpkg/apt user installed"))

    print(bold(f"\n🔍 Search Results for '{query}': {len(matches)} match(es) found\n" + "-" * 60))
    if not matches:
        print(yellow("No programs or packages matched your query.\n"))
        return

    for category, name, details in matches:
        cat_badge = magenta(f"[{category}]")
        print(f" {cat_badge:<20} {bold(name)}")
        print(f"   {dim(details)}")
    print()

