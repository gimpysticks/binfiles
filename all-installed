    print(f"  {green('✓')} Saved summary_all_programs.md")

    # 5. Generate comprehensive reinstall_apps.sh
    reinstall_script = f"""#!/bin/bash
# Multi-source reinstall script generated on {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${{BASH_SOURCE[0]}}")")" && pwd)"
LOG_FILE="$SCRIPT_DIR/reinstall_$(date +%Y%m%d_%H%M%S).log"

log() {{
    echo "$1" | tee -a "$LOG_FILE"
}}

log "=== Reinstall started at $(date) ==="

# Prevent interactive prompts from blocking automated installs
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a

# 1. APT Packages (Manual)
if [ -f "$SCRIPT_DIR/apt_manual_packages.txt" ]; then
    log "\\n=== Installing APT Manual Packages ==="
    while IFS= read -r pkg || [ -n "$pkg" ]; do
        [ -z "$pkg" ] && continue

        # Exclude GNOME, GNOME Shell, GDM, and Mutter packages (prevents conflicts & hangs on COSMIC)
        case "$pkg" in
            *gnome*|*gnome-shell*|*gdm*|*mutter*)
                log "SKIP: $pkg (excluded GNOME / GNOME Shell component)"
                continue
                ;;
        esac

        if dpkg -l | grep -q "^ii  $pkg "; then
            log "SKIP: $pkg (already installed)"
        else
            log "INSTALL: $pkg"
            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \\
                -o Dpkg::Options::="--force-confdef" \\
                -o Dpkg::Options::="--force-confold" \\
                "$pkg" >> "$LOG_FILE" 2>&1 || log "FAILED: $pkg"
        fi
    done < "$SCRIPT_DIR/apt_manual_packages.txt"
fi

# 2. Flatpak Apps
if [ -f "$SCRIPT_DIR/flatpak_apps_list.txt" ] && command -v flatpak >/dev/null 2>&1; then
    log "\\n=== Installing Flatpak Apps ==="
    while IFS= read -r app || [ -n "$app" ]; do
        [ -z "$app" ] && continue
        if flatpak list --app | grep -q "^$app"; then
            log "SKIP: $app (already installed)"
        else
            log "INSTALL: $app"
            flatpak install -y flathub "$app" >> "$LOG_FILE" 2>&1 || log "FAILED: $app"
        fi
    done < "$SCRIPT_DIR/flatpak_apps_list.txt"
fi

# 3. Snap Apps
if [ -f "$SCRIPT_DIR/snap_apps_list.txt" ] && command -v snap >/dev/null 2>&1; then
    log "\\n=== Installing Snap Apps ==="
    while IFS= read -r snap || [ -n "$snap" ]; do
        [ -z "$snap" ] && continue
        [ "$snap" = "snapd" ] && continue

        # Exclude GNOME runtime snap packages
        case "$snap" in
            *gnome*)
                log "SKIP: $snap (excluded GNOME component)"
                continue
                ;;
        esac

        if snap list 2>/dev/null | grep -q "^$snap "; then
            log "SKIP: $snap (already installed)"
        else
            log "INSTALL: $snap"
            sudo snap install "$snap" >> "$LOG_FILE" 2>&1 || log "FAILED: $snap"
        fi
    done < "$SCRIPT_DIR/snap_apps_list.txt"
fi

# 4. Cargo Crates
if [ -f "$SCRIPT_DIR/cargo_packages_list.txt" ] && command -v cargo >/dev/null 2>&1; then
    log "\\n=== Installing Cargo Packages ==="
    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        pkg=$(echo "$line" | awk '{{print $1}}')
        log "INSTALL: cargo install $pkg"
        cargo install "$pkg" >> "$LOG_FILE" 2>&1 || log "FAILED: cargo install $pkg"
    done < "$SCRIPT_DIR/cargo_packages_list.txt"
fi

# 5. Global NPM Packages
if [ -f "$SCRIPT_DIR/npm_global_packages_list.txt" ] && command -v npm >/dev/null 2>&1; then
    log "\\n=== Installing Global NPM Packages ==="
    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        pkg=$(echo "$line" | cut -d'@' -f1)
        [ "$pkg" = "npm" ] && continue
        [ "$pkg" = "corepack" ] && continue
        log "INSTALL: sudo npm install -g $pkg"
        sudo npm install -g "$pkg" >> "$LOG_FILE" 2>&1 || log "FAILED: npm $pkg"
    done < "$SCRIPT_DIR/npm_global_packages_list.txt"
fi

# 6. Python User Packages
if [ -f "$SCRIPT_DIR/python_packages_list.txt" ] && command -v pip >/dev/null 2>&1; then
    log "\\n=== Installing Python User Packages ==="
    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        pkg=$(echo "$line" | cut -d'=' -f1 | awk '{{print $1}}')
        log "INSTALL: pip install --user $pkg"
        pip install --user "$pkg" >> "$LOG_FILE" 2>&1 || log "FAILED: pip $pkg"
    done < "$SCRIPT_DIR/python_packages_list.txt"
fi

log "\\n=== AppImage Reminders ==="
if [ -f "$SCRIPT_DIR/appimage_files_list.txt" ]; then
    log "AppImages to manually restore:"
    cat "$SCRIPT_DIR/appimage_files_list.txt" | tee -a "$LOG_FILE"
fi

log "\\n=== Reinstallation finished at $(date) ==="
"""
    reinstall_path = os.path.join(output_dir, "reinstall_apps.sh")
    with open(reinstall_path, "w") as f:
        f.write(reinstall_script)
    os.chmod(reinstall_path, 0o775)
    print(f"  {green('✓')} Saved executable reinstall_apps.sh")

    print(bold(f"\n✨ Export complete! Backup located at: {output_dir}\n"))

def main():
    parser = argparse.ArgumentParser(
        description="Comprehensive inventory of installed programs regardless of source or package type."
    )
    parser.add_argument("search", nargs="?", help="Search query to filter installed programs across all sources")
    parser.add_argument("--export", "-e", nargs="?", const="DEFAULT", help="Export inventory files (optionally specify directory)")
    parser.add_argument("--json", action="store_true", help="Output all results as JSON")
    parser.add_argument("--markdown", action="store_true", help="Output overview in Markdown")
    parser.add_argument("--category", "-c", choices=["desktop", "flatpak", "snap", "appimage", "cargo", "npm", "python", "go", "apt", "local", "all"], help="Filter by specific category")
    parser.add_argument("--all", "-a", action="store_true", help="Print full lists of all categories")

    args = parser.parse_args()

    data = collect_all_data()

    if args.json:
        print(json.dumps(data, indent=2))
        return

    if args.markdown:
        # Quick markdown dump to stdout
        print("# Installed Programs\n")
        print_summary_table(data)
        return

    if args.export:
        if args.export == "DEFAULT":
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            output_dir = os.path.expanduser(f"~/bin/reinstall_prep_{timestamp}")
        else:
            output_dir = os.path.abspath(os.path.expanduser(args.export))
        export_all(data, output_dir)
        return

    if args.search:
        search_all(data, args.search)
        return

    # Category view or default summary
    print_summary_table(data)

    if args.category or args.all:
        cat = args.category or "all"

        if cat in ["desktop", "all"]:
            print(bold("\n🖥️  Desktop Applications:"))
            for d in data["desktop_apps"]:
                src = d['source']
                print(f"  • {bold(d['name'])} {dim(f'[{src}]')} -> {d['exec']}")

        if cat in ["flatpak", "all"]:
            print(bold("\n📦 Flatpak Applications:"))
            for f in data["flatpaks"]:
                print(f"  • {bold(f['name'])} ({cyan(f['id'])}) {dim(f['version'])} [{f['origin']}]")

        if cat in ["snap", "all"]:
            print(bold("\n⚡ Snap Applications:"))
            for s in data["snaps"]:
                if not s["is_core"]:
                    print(f"  • {bold(s['name'])} {dim(s['version'])} [{s['tracking']}]")

        if cat in ["appimage", "all"]:
            print(bold("\n🚀 AppImages:"))
            for a in data["appimages"]:
                size_mb = a['size_mb']
                print(f"  • {bold(a['name'])} {dim(f'({size_mb} MB)')} -> {a['path']}")

        if cat in ["cargo", "all"]:
            print(bold("\n🦀 Cargo Packages:"))
            for c in data["cargo"]:
                print(f"  • {bold(c['name'])} {dim(c['version'])} (Binaries: {', '.join(c['binaries'])})")

        if cat in ["npm", "all"]:
            print(bold("\n🌐 NPM Global Packages:"))
            for n in data["npm_global"]:
                print(f"  • {bold(n['name'])} {dim(n['version'])}")

        if cat in ["python", "all"]:
            print(bold("\n🐍 Python User Packages:"))
            for p in data["python_user"]:
                print(f"  • {bold(p['name'])} {dim(p['version'])} [{p['source']}]")

        if cat in ["go", "all"]:
            print(bold("\n🐹 Go Binaries:"))
            for g in data["go_binaries"]:
                print(f"  • {bold(g['name'])} -> {g['path']}")

        if cat in ["local", "all"]:
            print(bold("\n📁 Local Scripts (~/bin):"))
            print("  " + ", ".join(data["local_scripts"][:50]) + ("..." if len(data["local_scripts"]) > 50 else ""))

        if cat in ["apt"]:
            print(bold(f"\n🐧 APT Manually Installed ({len(data['apt_manual'])} packages):"))
            print("  " + " ".join(data["apt_manual"]))

        print()
    else:
        print(dim("Tip: Run 'all-installed <name>' to search (e.g. 'all-installed discord')"))
        print(dim("Tip: Run 'all-installed --category flatpak' (or desktop, snap, appimage, cargo, npm, python, etc.)"))
        print(dim("Tip: Run 'all-installed --export' to dump all lists + reinstall script for OS backup."))

if __name__ == "__main__":
    main()
