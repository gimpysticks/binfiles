#!/usr/bin/env python3
"""
midjourney-photos-sync: Synchronize Midjourney images to Google Photos.

Features:
- Compares local file dates & times with resident media items in the Google Photos
  'midjourney' album.
- Categorizes files as NEW, MODIFIED, or UP_TO_DATE.
- Uploads missing/updated files into the Google Photos album.
- Preserves all local files untouched on disk.
- Maintains a local sync manifest cache.
- Provides interactive OAuth 2.0 authentication and token auto-refresh.
- Includes --dry-run mode for testing and safe previews.
"""

import os
import sys
import json
import time
import mimetypes
import argparse
import datetime
import webbrowser
import threading
from pathlib import Path
from typing import Dict, List, Optional, Tuple, Any
from urllib.parse import urlparse, parse_qs, urlencode
from http.server import HTTPServer, BaseHTTPRequestHandler
import requests

# Default configuration paths
DEFAULT_ALBUM_NAME = "Midjourney"
DEFAULT_CONFIG_DIR = Path.home() / ".config" / "midjourney-photos-sync"
DEFAULT_CREDENTIALS_FILE = DEFAULT_CONFIG_DIR / "credentials.json"
DEFAULT_TOKEN_FILE = DEFAULT_CONFIG_DIR / "token.json"
DEFAULT_SYNC_STATE_FILE = DEFAULT_CONFIG_DIR / "sync_state.json"

# Supported image extensions
IMAGE_EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".tiff", ".bmp", ".heic"}

# Google OAuth & API endpoints
GOOGLE_AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token"
GOOGLE_PHOTOS_API_BASE = "https://photoslibrary.googleapis.com/v1"
OAUTH_REDIRECT_PORT = 8085
OAUTH_REDIRECT_URI = f"http://localhost:{OAUTH_REDIRECT_PORT}/"
SCOPES = [
    "https://www.googleapis.com/auth/photoslibrary.appendonly",
    "https://www.googleapis.com/auth/photoslibrary.readonly.appcreateddata",
    "https://www.googleapis.com/auth/photoslibrary.edit.appcreateddata",
]


# -----------------------------------------------------------------------------
# Local Directory Discovery
# -----------------------------------------------------------------------------

def discover_midjourney_directory(custom_path: Optional[str] = None) -> Path:
    """Find the local Midjourney directory based on common conventions."""
    if custom_path:
        p = Path(custom_path).expanduser().resolve()
        if p.exists() and p.is_dir():
            return p
        raise FileNotFoundError(f"Specified source directory does not exist: {custom_path}")

    candidates = [
        Path.home() / "Pictures" / "Midjourney",
        Path.home() / "Pictures" / "midjourney",
        Path.home() / "pictures" / "midjourney",
        Path("/home/pictures/midjourney"),
    ]

    for candidate in candidates:
        if candidate.exists() and candidate.is_dir():
            return candidate.resolve()

    # Fallback to default path even if not yet populated
    default_dir = Path.home() / "Pictures" / "Midjourney"
    return default_dir


def scan_local_files(source_dir: Path, recursive: bool = True) -> List[Dict[str, Any]]:
    """Scan local directory for supported image files and their modification timestamps."""
    files = []
    if not source_dir.exists():
        return files

    walker = source_dir.rglob("*") if recursive else source_dir.glob("*")

    for p in walker:
        if p.is_file() and p.suffix.lower() in IMAGE_EXTENSIONS:
            try:
                stat = p.stat()
                mtime_utc = datetime.datetime.fromtimestamp(stat.st_mtime, tz=datetime.timezone.utc)
                mtime_local = datetime.datetime.fromtimestamp(stat.st_mtime)
                files.append({
                    "name": p.name,
                    "path": str(p.resolve()),
                    "rel_path": str(p.relative_to(source_dir)),
                    "size": stat.st_size,
                    "mtime_posix": stat.st_mtime,
                    "mtime_utc": mtime_utc,
                    "mtime_iso": mtime_utc.isoformat(),
                    "mtime_display": mtime_local.strftime("%Y-%m-%d %H:%M:%S"),
                })
            except OSError as e:
                print(f"  [!] Warning: Could not stat file {p}: {e}", file=sys.stderr)

    # Sort files naturally by filename
    files.sort(key=lambda x: x["name"].lower())
    return files


# -----------------------------------------------------------------------------
# OAuth 2.0 Authentication & Token Management
# -----------------------------------------------------------------------------

class _OAuthCallbackHandler(BaseHTTPRequestHandler):
    """Temporary local HTTP server handler to receive OAuth authorization code."""
    auth_code: Optional[str] = None
    server_error: Optional[str] = None

    def do_GET(self):
        parsed = urlparse(self.path)
        params = parse_qs(parsed.query)

        if "code" in params:
            _OAuthCallbackHandler.auth_code = params["code"][0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            success_html = """
            <!DOCTYPE html>
            <html>
            <head><title>Authorization Successful</title></head>
            <body style="font-family: sans-serif; text-align: center; padding: 40px; background: #f4f6f8;">
              <h2 style="color: #2e7d32;">Authentication Successful!</h2>
              <p>Google Photos authorization completed successfully.</p>
              <p>You can close this browser window and return to your terminal.</p>
            </body>
            </html>
            """
            self.wfile.write(success_html.encode("utf-8"))
        elif "error" in params:
            _OAuthCallbackHandler.server_error = params["error"][0]
            self.send_response(400)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            err_html = f"<h2>Authentication Failed</h2><p>Error: {params['error'][0]}</p>"
            self.wfile.write(err_html.encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        # Silence HTTP server logs to keep CLI clean
        return


def load_credentials_file(creds_path: Path) -> Tuple[str, str]:
    """Parse Google OAuth client ID and client secret from JSON file."""
    if not creds_path.exists():
        print_credentials_help(creds_path)
        sys.exit(1)

    try:
        with open(creds_path, "r", encoding="utf-8") as f:
            data = json.load(f)

        app_info = data.get("installed") or data.get("web") or data
        client_id = app_info.get("client_id")
        client_secret = app_info.get("client_secret")

        if not client_id or not client_secret:
            raise ValueError("Missing 'client_id' or 'client_secret' in credentials file.")

        return client_id, client_secret
    except Exception as e:
        print(f"Error reading credentials file {creds_path}: {e}", file=sys.stderr)
        sys.exit(1)


