def get_valid_access_token(creds_path: Path, token_path: Path) -> str:
    """Retrieve a valid OAuth access token, refreshing or authenticating if necessary."""
    client_id, client_secret = load_credentials_file(creds_path)
    now = time.time()

    # Check existing token file
    if token_path.exists():
        try:
            with open(token_path, "r", encoding="utf-8") as f:
                token_data = json.load(f)

            expires_at = token_data.get("expires_at", 0)
            access_token = token_data.get("access_token")
            refresh_token = token_data.get("refresh_token")

            # Still valid with a 60-second buffer
            if access_token and (expires_at - now > 60):
                return access_token

            # Try refreshing token
            if refresh_token:
                print("Access token expired. Refreshing OAuth token...")
                resp = requests.post(
                    GOOGLE_TOKEN_URL,
                    data={
                        "client_id": client_id,
                        "client_secret": client_secret,
                        "refresh_token": refresh_token,
                        "grant_type": "refresh_token",
                    },
                    timeout=20,
                )
                if resp.status_code == 200:
                    new_tokens = resp.json()
                    token_data["access_token"] = new_tokens["access_token"]
                    token_data["expires_at"] = now + new_tokens.get("expires_in", 3600)
                    if "refresh_token" in new_tokens:
                        token_data["refresh_token"] = new_tokens["refresh_token"]

                    token_path.parent.mkdir(parents=True, exist_ok=True)
                    with open(token_path, "w", encoding="utf-8") as f:
                        json.dump(token_data, f, indent=2)
                    token_path.chmod(0o600)
                    return token_data["access_token"]
                else:
                    print(f"Token refresh failed ({resp.status_code}): {resp.text}")
                    print("Re-authenticating...")
        except Exception as e:
            print(f"Warning: Could not read or refresh token: {e}")

    # Interactive Authentication Flow
    return perform_oauth_flow(client_id, client_secret, token_path)


def perform_oauth_flow(client_id: str, client_secret: str, token_path: Path) -> str:
    """Run interactive OAuth 2.0 authorization with local callback listener."""
    auth_params = {
        "client_id": client_id,
        "redirect_uri": OAUTH_REDIRECT_URI,
        "response_type": "code",
        "scope": " ".join(SCOPES),
        "access_type": "offline",
        "prompt": "consent",
    }
    auth_url = f"{GOOGLE_AUTH_URL}?{urlencode(auth_params)}"

    _OAuthCallbackHandler.auth_code = None
    _OAuthCallbackHandler.server_error = None

    server: Optional[HTTPServer] = None
    server_thread: Optional[threading.Thread] = None
    use_local_server = True

    try:
        server = HTTPServer(("localhost", OAUTH_REDIRECT_PORT), _OAuthCallbackHandler)
        server.timeout = 180  # 3 minutes timeout
        server_thread = threading.Thread(target=server.handle_request, daemon=True)
        server_thread.start()
    except Exception as e:
        use_local_server = False
        print(f"Notice: Could not bind local callback server on port {OAUTH_REDIRECT_PORT}: {e}")

    print("\n" + "=" * 72)
    print(" Google Photos Authorization Required")
    print("=" * 72)
    print("Opening authorization page in your browser...")
    print(f"\nIf the browser does not open automatically, visit this URL:\n\n  {auth_url}\n")

    try:
        webbrowser.open(auth_url)
    except Exception:
        pass

    auth_code = None
    if use_local_server and server_thread:
        print("Waiting for browser authorization...")
        server_thread.join(timeout=180)
        auth_code = _OAuthCallbackHandler.auth_code

    if not auth_code:
        print("\nAutomatic callback not received. Please copy the code from the redirect URL.")
        auth_code = input("Enter authorization code: ").strip()

    if not auth_code:
        print("Error: No authorization code provided.", file=sys.stderr)
        sys.exit(1)

    print("Exchanging authorization code for tokens...")
    resp = requests.post(
        GOOGLE_TOKEN_URL,
        data={
            "client_id": client_id,
            "client_secret": client_secret,
            "code": auth_code,
            "redirect_uri": OAUTH_REDIRECT_URI,
            "grant_type": "authorization_code",
        },
        timeout=20,
    )

    if resp.status_code != 200:
        print(f"Error exchanging authorization code: {resp.status_code}\n{resp.text}", file=sys.stderr)
        sys.exit(1)

    token_data = resp.json()
    token_data["expires_at"] = time.time() + token_data.get("expires_in", 3600)

    token_path.parent.mkdir(parents=True, exist_ok=True)
    with open(token_path, "w", encoding="utf-8") as f:
        json.dump(token_data, f, indent=2)
    token_path.chmod(0o600)

    print("Authentication successful! Token saved securely.\n")
    return token_data["access_token"]


# -----------------------------------------------------------------------------
# Google Photos API Operations
# -----------------------------------------------------------------------------

def parse_iso_datetime(dt_str: str) -> Optional[datetime.datetime]:
    """Parse Google Photos creationTime ISO 8601 string into a UTC datetime."""
    if not dt_str:
        return None
    try:
        # Standardize UTC trailing 'Z'
        if dt_str.endswith("Z"):
            dt_str = dt_str[:-1] + "+00:00"
        return datetime.datetime.fromisoformat(dt_str)
    except Exception:
        return None


def get_or_create_album(access_token: str, album_name: str, cached_album_id: Optional[str] = None) -> Tuple[str, str]:
    """Find album by cached ID or name (case-insensitive), or create it if missing."""
    headers = {"Authorization": f"Bearer {access_token}"}

    # 1. First priority: Check cached album ID directly (survives user album renames)
    if cached_album_id:
        try:
            resp = requests.get(f"{GOOGLE_PHOTOS_API_BASE}/albums/{cached_album_id}", headers=headers, timeout=15)
            if resp.status_code == 200:
                data = resp.json()
                current_title = data.get("title", album_name)
                return cached_album_id, current_title
        except Exception:
            pass

    # 2. Second priority: Search user's app-created albums by name
    page_token = None
    target_lower = album_name.lower().strip()

    while True:
        url = f"{GOOGLE_PHOTOS_API_BASE}/albums?pageSize=50"
        if page_token:
            url += f"&pageToken={page_token}"

        resp = requests.get(url, headers=headers, timeout=20)
        if resp.status_code != 200:
            raise RuntimeError(f"Failed to list Google Photos albums ({resp.status_code}): {resp.text}")

        data = resp.json()
        for album in data.get("albums", []):
            title = album.get("title", "")
            if title.lower().strip() == target_lower:
                return album["id"], title

        page_token = data.get("nextPageToken")
        if not page_token:
            break

    # 3. Third priority: Album not found; create it
    print(f"Album '{album_name}' not found. Creating new Google Photos album...")
    create_resp = requests.post(
        f"{GOOGLE_PHOTOS_API_BASE}/albums",
        headers={"Authorization": f"Bearer {access_token}", "Content-Type": "application/json"},
        json={"album": {"title": album_name}},
        timeout=20,
    )
    if create_resp.status_code != 200:
        raise RuntimeError(f"Failed to create album '{album_name}' ({create_resp.status_code}): {create_resp.text}")

    new_album = create_resp.json()
    return new_album["id"], new_album.get("title", album_name)


def fetch_resident_media_items(access_token: str, album_id: str, max_pages: int = 5) -> Dict[str, Dict[str, Any]]:
    """Fetch resident media items from the target album (bounded by max_pages to prevent hanging on massive collections)."""
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
    }
    resident_items: Dict[str, Dict[str, Any]] = {}
    page_token = None
    pages = 0

    while pages < max_pages:
        body: Dict[str, Any] = {"albumId": album_id, "pageSize": 100}
        if page_token:
            body["pageToken"] = page_token

        resp = requests.post(
            f"{GOOGLE_PHOTOS_API_BASE}/mediaItems:search",
            headers=headers,
            json=body,
            timeout=20,
        )

        if resp.status_code != 200:
            break

        data = resp.json()
        items = data.get("mediaItems", [])
        pages += 1

        for item in items:
            filename = item.get("filename", "")
            if not filename:
                continue

            metadata = item.get("mediaMetadata", {})
            creation_str = metadata.get("creationTime", "")
            creation_dt = parse_iso_datetime(creation_str)

            # Store the latest creation date if duplicate filenames exist
            if filename in resident_items:
                prev_dt = resident_items[filename]["creation_dt"]
                if prev_dt and creation_dt and creation_dt > prev_dt:
                    resident_items[filename] = {
                        "id": item.get("id"),
                        "filename": filename,
                        "creation_str": creation_str,
                        "creation_dt": creation_dt,
                        "mimeType": item.get("mimeType"),
                    }
            else:
                resident_items[filename] = {
                    "id": item.get("id"),
                    "filename": filename,
                    "creation_str": creation_str,
                    "creation_dt": creation_dt,
                    "mimeType": item.get("mimeType"),
                }

        page_token = data.get("nextPageToken")
        if not page_token:
            break

    return resident_items


# -----------------------------------------------------------------------------
# Comparison Engine
# -----------------------------------------------------------------------------

def compare_files_against_album(
    local_files: List[Dict[str, Any]],
    remote_items: Dict[str, Dict[str, Any]],
    sync_manifest: Dict[str, Any],
    force_all: bool = False,
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]], List[Dict[str, Any]]]:
    """
    Compare local file timestamps against sync manifest and Google Photos album.

    Returns:
        new_files: Files not yet synced or present in album.
        modified_files: Files modified locally after the last recorded sync.
        up_to_date_files: Files already synced with matching or older local timestamps.
    """
    new_files = []
    modified_files = []
    up_to_date_files = []

    for file_info in local_files:
        filename = file_info["name"]

        if force_all:
            file_info["sync_status"] = "FORCED"
            file_info["sync_reason"] = "Forced upload requested."
            new_files.append(file_info)
            continue

        # Check sync manifest first (instantaneous & accurate)
        if filename in sync_manifest:
            entry = sync_manifest[filename]
            cached_mtime_str = entry.get("mtime_iso", "")
            cached_dt = parse_iso_datetime(cached_mtime_str)
            local_dt = file_info["mtime_utc"]

            if cached_dt and (local_dt - cached_dt).total_seconds() > 2.0:
                file_info["sync_status"] = "MODIFIED"
                rem_display = cached_dt.astimezone().strftime("%Y-%m-%d %H:%M:%S")
                file_info["sync_reason"] = f"Local modified ({file_info['mtime_display']}) > Previous sync ({rem_display})"
                modified_files.append(file_info)
            else:
                file_info["sync_status"] = "UP_TO_DATE"
                rem_display = cached_dt.astimezone().strftime("%Y-%m-%d %H:%M:%S") if cached_dt else "synced"
                file_info["sync_reason"] = f"Synchronized with Google Photos ({rem_display})"
                up_to_date_files.append(file_info)
        elif filename in remote_items:
            remote_info = remote_items[filename]
            remote_dt = remote_info.get("creation_dt")
            local_dt = file_info["mtime_utc"]

            if remote_dt is None or (local_dt - remote_dt).total_seconds() > 2.0:
                file_info["sync_status"] = "MODIFIED"
                rem_display = remote_dt.strftime("%Y-%m-%d %H:%M:%S") if remote_dt else "unknown"
                file_info["sync_reason"] = f"Local modified ({file_info['mtime_display']}) > Remote ({rem_display})"
                modified_files.append(file_info)
            else:
                file_info["sync_status"] = "UP_TO_DATE"
                rem_display = remote_dt.strftime("%Y-%m-%d %H:%M:%S") if remote_dt else "identical"
                file_info["sync_reason"] = f"Resident in Google Photos ({rem_display})"
                up_to_date_files.append(file_info)
        else:
            file_info["sync_status"] = "NEW"
            file_info["sync_reason"] = "File is not yet uploaded to Google Photos album."
            new_files.append(file_info)

    return new_files, modified_files, up_to_date_files


# -----------------------------------------------------------------------------
# Upload Engine (Preserves Local Files)
# -----------------------------------------------------------------------------

def upload_single_file_bytes(access_token: str, file_path: str, filename: str) -> str:
    """Upload raw image bytes to Google Photos upload endpoint and obtain uploadToken."""
    mime_type, _ = mimetypes.guess_type(file_path)
    if not mime_type:
        mime_type = "application/octet-stream"

    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/octet-stream",
        "X-Goog-Upload-Content-Type": mime_type,
        "X-Goog-Upload-Protocol": "raw",
    }

    with open(file_path, "rb") as f:
        file_bytes = f.read()

    resp = requests.post(
        f"{GOOGLE_PHOTOS_API_BASE}/uploads",
        headers=headers,
        data=file_bytes,
        timeout=60,
    )

    if resp.status_code != 200:
        raise RuntimeError(f"Failed to upload {filename} ({resp.status_code}): {resp.text}")

    upload_token = resp.text.strip()
    return upload_token


def batch_create_album_items(
    access_token: str,
    album_id: str,
    uploaded_batch: List[Tuple[Dict[str, Any], str]],
) -> List[Dict[str, Any]]:
    """Batch register uploaded tokens into the Google Photos album (max 50 per batch)."""
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
    }

    new_media_items = []
    for file_info, upload_token in uploaded_batch:
        new_media_items.append({
            "description": file_info["name"],
            "simpleMediaItem": {
                "fileName": file_info["name"],
                "uploadToken": upload_token,
            },
        })

    resp = requests.post(
        f"{GOOGLE_PHOTOS_API_BASE}/mediaItems:batchCreate",
        headers=headers,
        json={"albumId": album_id, "newMediaItems": new_media_items},
        timeout=40,
    )

    if resp.status_code != 200:
        raise RuntimeError(f"batchCreate failed ({resp.status_code}): {resp.text}")

    return resp.json().get("newMediaItemResults", [])


def execute_upload_sync(
    access_token: str,
    album_id: str,
    files_to_upload: List[Dict[str, Any]],
    state_file: Path,
) -> Tuple[int, int]:
    """Upload determined files into the Google Photos album, keeping local files safe."""
    total_files = len(files_to_upload)
    if total_files == 0:
        print("No files need uploading. Everything is up to date!")
        return 0, 0

    print(f"\nStarting upload of {total_files} file(s) to Google Photos album...")
    print("Note: Local files are preserved intact on disk.")

    # Load existing sync state
    sync_state = {}
    if state_file.exists():
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                sync_state = json.load(f)
        except Exception:
            sync_state = {}

    if "files" not in sync_state:
        sync_state["files"] = {}

    success_count = 0
    failure_count = 0
    batch_size = 20  # Safe batch size under the 50 item API limit
    current_batch: List[Tuple[Dict[str, Any], str]] = []

    for index, file_info in enumerate(files_to_upload, 1):
        filename = file_info["name"]
        file_path = file_info["path"]
        size_mb = file_info["size"] / (1024 * 1024)

        try:
            print(f"[{index}/{total_files}] Uploading {filename} ({size_mb:.2f} MB)...", end="", flush=True)
            upload_token = upload_single_file_bytes(access_token, file_path, filename)
            current_batch.append((file_info, upload_token))
            print(" [Uploaded bytes]")

            # When batch fills or end of list, commit to album
            if len(current_batch) >= batch_size or index == total_files:
                print(f"  -> Adding batch of {len(current_batch)} item(s) to album...", end="", flush=True)
                results = batch_create_album_items(access_token, album_id, current_batch)

                for (item_info, _), res in zip(current_batch, results):
                    res_status = res.get("status", {})
                    msg = res_status.get("message", "Success")
                    item_name = item_info["name"]

                    if msg.lower() in ("success", "ok") or "mediaItem" in res:
                        success_count += 1
                        media_item_id = res.get("mediaItem", {}).get("id")
                        sync_state["files"][item_name] = {
                            "path": item_info["path"],
                            "size": item_info["size"],
                            "mtime_iso": item_info["mtime_iso"],
                            "uploaded_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                            "google_photos_id": media_item_id,
                        }
                    else:
                        failure_count += 1
                        print(f"\n  [!] Failed to commit {item_name}: {msg}")

                print(" Done.")
                current_batch = []

                # Save intermediate sync state
                try:
                    state_file.parent.mkdir(parents=True, exist_ok=True)
                    with open(state_file, "w", encoding="utf-8") as f:
                        json.dump(sync_state, f, indent=2)
                except Exception:
                    pass

        except Exception as e:
            failure_count += 1
            print(f" [FAILED: {e}]")

    # Final sync state save
    sync_state["last_sync_timestamp"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    sync_state["album_id"] = album_id
    try:
        state_file.parent.mkdir(parents=True, exist_ok=True)
        with open(state_file, "w", encoding="utf-8") as f:
            json.dump(sync_state, f, indent=2)
    except Exception:
        pass

    return success_count, failure_count


# -----------------------------------------------------------------------------
# CLI Entrypoint & Reporting
# -----------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="midjourney-photos-sync",
        description="Compare file dates/times in local Midjourney folder against Google Photos and upload missing/modified items.",
    )
    parser.add_argument(
        "-s", "--source-dir",
        type=str,
        default=None,
        help="Local Midjourney folder path (default: ~/Pictures/Midjourney)",
    )
    parser.add_argument(
        "-a", "--album-name",
        type=str,
        default=DEFAULT_ALBUM_NAME,
        help=f"Target Google Photos album name (default: '{DEFAULT_ALBUM_NAME}')",
    )
    parser.add_argument(
        "-n", "--dry-run",
        action="store_true",
        help="Inspect file dates/times and preview sync actions without uploading",
    )
    parser.add_argument(
        "-f", "--force",
        action="store_true",
        help="Force upload all files regardless of timestamps",
    )
    parser.add_argument(
        "--no-recursive",
        action="store_true",
        help="Do not scan subdirectories inside the source directory",
    )
    parser.add_argument(
        "--scan-only",
        action="store_true",
        help="Scan and list local Midjourney image files and timestamps without connecting to Google Photos",
    )
    parser.add_argument(
        "--auth",
        action="store_true",
        help="Verify or refresh Google Photos OAuth authentication only",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="List Google Photos albums and contents of the Midjourney album",
    )
    parser.add_argument(
        "-c", "--credentials",
        type=str,
        default=str(DEFAULT_CREDENTIALS_FILE),
        help=f"Path to OAuth credentials JSON file (default: {DEFAULT_CREDENTIALS_FILE})",
    )
    parser.add_argument(
        "-t", "--token",
        type=str,
        default=str(DEFAULT_TOKEN_FILE),
        help=f"Path to saved OAuth token JSON file (default: {DEFAULT_TOKEN_FILE})",
    )

    args = parser.parse_args()

    creds_path = Path(args.credentials).expanduser().resolve()
    token_path = Path(args.token).expanduser().resolve()
    state_file = DEFAULT_SYNC_STATE_FILE

    print("=" * 72)
    print(" Midjourney -> Google Photos Sync")
    print("=" * 72)

    # Resolve local directory
    try:
        source_dir = discover_midjourney_directory(args.source_dir)
        print(f"Local Directory : {source_dir}")
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"Target Album    : {args.album_name}")
    print(f"Mode            : {'DRY RUN (Preview Only)' if args.dry_run else 'LIVE SYNC'}")
    print("-" * 72)

    # 1. Scan Local Files
    print(f"Scanning local files in {source_dir}...")
    local_files = scan_local_files(source_dir, recursive=not args.no_recursive)
    print(f"[✓] Found {len(local_files)} local image file(s).")

    if not local_files:
        print(f"No supported images found in {source_dir}.")
        return

    if args.scan_only:
        print("\nLocal Files Inventory:")
        for item in local_files:
            size_kb = item["size"] / 1024
            print(f"  • {item['name']:<70} {item['mtime_display']} ({size_kb:.1f} KB)")
        print(f"\nTotal: {len(local_files)} file(s) resident on disk.")
        return

    # 2. Check if credentials exist before network calls
    if not creds_path.exists():
        print(f"\nLocal Directory Inspection:")
        print(f"  • Files found: {len(local_files)}")
        if local_files:
            earliest = min(local_files, key=lambda x: x["mtime_posix"])
            latest = max(local_files, key=lambda x: x["mtime_posix"])
            print(f"  • Date range : {earliest['mtime_display']} to {latest['mtime_display']}")
            print(f"  • Recent file: {latest['name']} ({latest['mtime_display']})")
        print_credentials_help(creds_path)
        sys.exit(1)

    # 3. Authenticate with Google Photos
    print("Checking Google Photos authentication...")
    access_token = get_valid_access_token(creds_path, token_path)

    if args.auth:
        print("[✓] Authentication verified successfully!")
        return

    # 4. Resolve Google Photos Album
    cached_album_id = None
    if state_file.exists():
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                cached_album_id = json.load(f).get("album_id")
        except Exception:
            pass

    print(f"Connecting to Google Photos album...")
    try:
        album_id, album_title = get_or_create_album(access_token, args.album_name, cached_album_id=cached_album_id)
        print(f"[✓] Connected to album: '{album_title}' (ID: {album_id})")
    except Exception as e:
        print(f"Error accessing Google Photos album: {e}", file=sys.stderr)
        sys.exit(1)

    # 5. Retrieve Resident Media Items
    print(f"Inspecting resident items in Google Photos album...")
    try:
        remote_items = fetch_resident_media_items(access_token, album_id)
        print(f"[✓] Found {len(remote_items)} resident media item(s) in album.")
    except Exception as e:
        print(f"Error fetching album contents: {e}", file=sys.stderr)
        sys.exit(1)

    if args.list:
        print("\nResident Items in Album:")
        for name, item in sorted(remote_items.items()):
            dt_str = item["creation_str"] or "N/A"
            print(f"  - {name} [Creation: {dt_str}]")
        return

    # 6. Date & Time Comparison
    print("\nComparing local dates/times with sync manifest and Google Photos album...")
    sync_manifest = {}
    if state_file.exists():
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                sync_manifest = json.load(f).get("files", {})
        except Exception:
            pass

    new_files, modified_files, up_to_date_files = compare_files_against_album(
        local_files, remote_items, sync_manifest=sync_manifest, force_all=args.force
    )

    print("\n" + "=" * 72)
    print(" Comparison Summary")
    print("=" * 72)
    print(f"  • Total local images       : {len(local_files):>5}")
    print(f"  • Resident in Google Photos: {len(remote_items):>5}")
    print(f"  • Already Up-to-Date       : {len(up_to_date_files):>5}")
    print(f"  • New (Missing from Album) : {len(new_files):>5}")
    print(f"  • Modified (Newer locally) : {len(modified_files):>5}")
    print("-" * 72)

    files_to_upload = new_files + modified_files

    if files_to_upload:
        print("\nFiles to Upload:")
        for item in files_to_upload[:15]:
            status_tag = f"[{item['sync_status']}]"
            print(f"  {status_tag:<11} {item['name']} (Local: {item['mtime_display']})")
        if len(files_to_upload) > 15:
            print(f"  ... and {len(files_to_upload) - 15} more file(s).")
    else:
        print("\nAll local files are fully synchronized with Google Photos.")

    # 6. Execute Upload if not dry run
    if args.dry_run:
        print("\n[!] DRY RUN active: No files were uploaded.")
        print("Run without '--dry-run' to perform the upload.")
        return

    if not files_to_upload:
        return

    # Keep files policy reminder
    print("\nPolicy check: Local hard drive files will be kept intact.")
    success, failure = execute_upload_sync(access_token, album_id, files_to_upload, state_file)

    print("\n" + "=" * 72)
    print(" Sync Complete")
    print("=" * 72)
    print(f"  • Successfully uploaded: {success}")
    print(f"  • Failed uploads       : {failure}")
    print(f"  • Preserved local files: {len(local_files)}")
    print("=" * 72)


if __name__ == "__main__":
    main()
