#!/usr/bin/env bash
#
# Restart the readynasd service on the NAS (192.168.4.2).
# Useful for clearing accumulated CPU/memory bloat that causes the fan to
# spin up intermittently.

set -u

NAS_HOST="${NAS_HOST:-192.168.4.2}"
NAS_USER="${NAS_USER:-root}"

ssh "${NAS_USER}@${NAS_HOST}" 'systemctl restart readynasd'
